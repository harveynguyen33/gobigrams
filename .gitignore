# runtime data — one JSON file per board, written by the dev middleware
boards/

# dependencies
node_modules/

# build output
dist/

# logs / editor / OS noise
*.log
.DS_Store
.vite/

# harness scratch — checks/round-as-boards-put.mjs writes its probe output into the
# repo root and used to leave it behind untracked (flagged by the reviewer as MAJOR
# housekeeping 2026-10-21). The leak is being closed in the harness; this is the belt.
.as-boards-out-*.cjs

# local env — never commit secrets
.env
.env.local
*.local

# >>> agent harness runtime state >>>
# runtime state written by the local gate runner (not fixtures)
.gob/last-gate-line
.gob/.ds-report
.gob/ratchet-last
# the secret family (SC-02): each is one `git add` away from a live credential
.env
.env.*
*.pem
*.key
# declared runtime_data (DS-01 hashes them around every gate run)
.gob/state.json
# <<< agent harness runtime state <<<

# research artifacts (deep-dive reports, harnesses)
research/
# ROUND AY item 4 scratch: the pixel-diff AFTER captures (regenerated per run
# by checks/round-ay-png-diff.mjs; only the BEFORE fixtures are committed)
.ay4-png-after/
.ay4-diff-report.json
# ROUND GOBI-2 scratch: the .gobi live probe's screenshots + console log
.gobi-live/
# ROUND GOBI-2: scripts/gobi-render.mjs bundles the TS compiler into the repo
# root (a /tmp file cannot resolve this project's node_modules), then removes it
.gobi-render-entry.ts
.gobi-render-out.mjs

# ROUND C scratch: the live-probe artefacts (probe board SVG/PNG rasters,
# regenerated per run by checks/round-c-live.mjs)
.rc-live/

# transient agent-run litter (never shipped)
.ay4-entry.ts
.ay4-out.mjs
.az-live/
.selbox-live/
.rc-entry.ts
.rc-out.mjs
