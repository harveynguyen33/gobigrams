#!/usr/bin/env bash
# goblin-verify — execute the target-scope rows of manifest/enforcement.tsv.
#
# Usage:
#   goblin-verify [--only <id[,id...]>] [--json] [--list] [--source <goblin-stack path>]
#
# Exit codes:
#   0  every executed check passed (advisories and skips do not fail the run)
#   1  at least one check FAILED
#   2  verify could not run (not installed, missing dependency, unparseable config)
#   3  the manifest itself is broken (a row with no check and no 'advisory', or a duplicate id)
#
# The check column of each row holds either
#   * a shell command, run from the target repo root, or
#   * the literal 'advisory' (counted, never executed), or
#   * 'goblin-verify --only <ID>', the marker for a check that needs logic beyond one
#     shell line. Those are implemented as builtins below; the marker keeps the row
#     self-describing and keeps the matrix the single source of truth.

set -uo pipefail

GOBLIN_VERIFY_VERSION="0.6.0-beta.1"
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=goblin-lib.sh
. "$SELF_DIR/goblin-lib.sh"

ONLY=""
JSON=0
LIST=0
LIBRARY_LIST=0
SOURCE=""
VERBOSE=0
# PASS details collapse to (ok) in the default listing; --verbose (or --only, which is a
# forensic single-row run) restores the full payload line by line.
if [ "${ONLY:-}" != "" ]; then VERBOSE=1; fi

usage() {
  cat <<'USAGE'
goblin-verify — prove a goblin-stack install is still what it says it is.

  --only <id[,id...]>   run only these manifest rows
  --verbose             print every row full-width (the default collapses PASS payloads
                        to a count; FAIL and ADV always print in full)
  --list                list the on-by-default rows and exit
  --library             list the OFF-by-default rows (the library) and exit — each with a
                        one-line purpose and the exact line that turns it on
  --json                machine-readable output
  --source <path>       read the manifest from a goblin-stack checkout instead of .gob/

Exit codes: 0 pass | 1 a check failed | 2 could not run | 3 the manifest is broken.
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --only)   ONLY="${2:-}"; VERBOSE=1; shift 2 ;;
    --json)   JSON=1; shift ;;
    --list)   LIST=1; shift ;;
    --library) LIBRARY_LIST=1; shift ;;
    --verbose) VERBOSE=1; shift ;;
    --source) SOURCE="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) g_err "unknown option: $1"; usage >&2; exit 2 ;;
  esac
done

# ---------------------------------------------------------------- environment --
for dep in git awk sed grep python3; do
  command -v "$dep" >/dev/null 2>&1 || { g_err "missing dependency: $dep"; exit 2; }
done

# Root resolution. `git rev-parse --show-toplevel` alone verifies the OUTER repo when the
# target is nested inside another git repo (a monorepo subdirectory, anything under
# ~/.hermes) — the installed config is the target's own marker, so it wins (D20).
find_installed_root() {
  local d="$PWD"
  while :; do
    if [ -f "$d/AGENTS.md" ] && grep -q "^$GOB_AGENTS_BEGIN" "$d/AGENTS.md" 2>/dev/null; then printf '%s\n' "$d"; return 0; fi
    [ "$d" = "/" ] && return 1
    d=$(dirname "$d")
  done
}
ROOT=$(find_installed_root) || ROOT=""
if [ -z "$ROOT" ]; then
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
  [ -n "$ROOT" ] || ROOT="$PWD"
fi

# ---- engine resolution (W1, §2.3): one chain, stated once --------------------
# Every engine-path lookup (enforcement.tsv, bans.tsv, bans/*.sh, the ban
# engine) resolves through this chain, first hit wins:
#   1. --source <path>            (existing flag; highest, for tests and pinned CI)
#   2. $ROOT/.gob/...             (vendored per-repo engine — today's default)
#   3. engine_dir: from $ROOT/AGENTS.md
#   4. GOBLIN_ENGINE_DIR env, then ~/.goblin/engine
#   5. nothing found -> exit 2, naming every path tried (the pre-W1 message when the
#      vendored chain is the only one tried; the §2.4 message when engine_dir: fails).
# Ordering is deliberate: a vendored engine still wins over the global one, because an
# explicit per-repo choice must not be silently overridden by a machine-level upgrade.
# An explicit engine_dir: that cannot be used is exit 2 with NO fallback (§1.2): falling
# back to a vendored engine would judge the repo with a different rule table than the one
# it declared. Absent key => the chain degrades to exactly today's behaviour (§1.3).

CONFIG="$ROOT/AGENTS.md"

# engine_yaml_raw — the raw engine_dir: value from the AGENTS.md frontmatter (the
# line-oriented parser reads the line, so a non-string scalar is visible here as
# something that is not a path).
engine_yaml_raw() {
  g_agents_read "$CONFIG" engine_dir
}

# resolve_engine_dir — validate the declared key (§1.2, fail closed at use time, stages
# 1-4) and print the absolute engine directory. Stages 3/4 (existence, payload) do NOT
# exit here: the failure is reported through ENGINE_FAIL so the refusal can name BOTH the
# declared value and the chain tried (§2.4's message), then the run stops with exit 2 —
# no fallback, no SKIP.
ENGINE_DECLARED=""
ENGINE_FAIL=""
ENGINE_DIR_DECLARED=""   # the declared value as written (for the §2.4 refusal message)
resolve_engine_dir() {
  ENGINE_DECLARED=""
  ENGINE_FAIL=""
  ENGINE_DIR_DECLARED=""
  [ -f "$CONFIG" ] || return 0
  [ -n "$(g_agents_keys "$CONFIG" | grep -qx engine_dir && echo 1)" ] || return 0
  local dir
  dir=$(engine_yaml_raw)
  if [ -z "$dir" ]; then
    ENGINE_FAIL="engine_dir: must be a string path, got empty"
    return 1
  fi
  dir=$(g_unquote "$dir")
  ENGINE_DIR_DECLARED="$dir"
  # Stage 1: a non-string value (number, list, mapping, bare null/bool) is not a path.
  # Anything that is not a usable path shape fails closed here and `got <value>` names
  # what was declared; valid strings fall through to the shape check below.
  ENGINE_FAIL="engine_dir: must be a string path, got $dir"
  case "$dir" in
    '~'|'null'|'true'|'false'|'['*|'{'*|''|*[!0-9A-Za-z_./~-]*|[0-9]*)
      return 1 ;;
  esac
  ENGINE_FAIL=""
  # Stage 2: the shape — absolute, or ~/ (expanded once, at read time, via $HOME).
  case "$dir" in
    /*) ;;
    "~/"*) dir="$HOME/${dir#\~/}" ;;
    *)
      ENGINE_FAIL="engine_dir: must be absolute or ~/-prefixed: $dir"
      return 1 ;;
  esac
  # Stage 3: existence.
  if [ ! -d "$dir" ]; then
    ENGINE_FAIL="engine_dir: $dir does not exist (declared in AGENTS.md)"
    return 1
  fi
  # Stage 4: the payload — a directory without the rule table is not an engine.
  if [ ! -f "$dir/manifest/enforcement.tsv" ]; then
    ENGINE_FAIL="engine_dir: no manifest/enforcement.tsv under $dir - this is not an engine directory"
    return 1
  fi
  ENGINE_DECLARED="$dir"
  return 0
}

resolve_engine_dir
ENGINE_CHAIN_VENDORED="\$ROOT/.gob/manifest/enforcement.tsv"
GOBLIN_ENGINE=""                       # the resolved engine root, when NOT vendored/--source
if [ -n "$SOURCE" ]; then
  MANIFEST="$SOURCE/manifest/enforcement.tsv"
elif [ -f "$ROOT/.gob/manifest/enforcement.tsv" ]; then
  MANIFEST="$ROOT/.gob/manifest/enforcement.tsv"
elif [ -n "$ENGINE_DECLARED" ]; then
  GOBLIN_ENGINE="$ENGINE_DECLARED"
  MANIFEST="$GOBLIN_ENGINE/manifest/enforcement.tsv"
elif [ -n "$ENGINE_FAIL" ]; then
  # §2.4: an explicit engine_dir: that does not resolve is exit 2, and nothing falls
  # back. The refusal names the declared value and every path the chain tried.
  g_err "$ENGINE_FAIL"
  g_err "no manifest at any of: \$SOURCE (${SOURCE:-unset}), $ROOT/.gob/manifest/enforcement.tsv (absent),"
  g_err "  $ENGINE_DIR_DECLARED/manifest/enforcement.tsv (unusable - see above)"
  exit 2
else
  # No vendored engine and no declaration: the CLI default (§3.3), env first, then
  # ~/.goblin/engine. Both are consulted AFTER --source, vendored and the declaration:
  # the most specific declaration wins; the machine default is the fallback, never an
  # override (A9).
  _cli_default=""
  if [ -n "${GOBLIN_ENGINE_DIR:-}" ]; then
    _cli_default="$GOBLIN_ENGINE_DIR"
  elif [ -d "$HOME/.gob/engine" ]; then
    _cli_default="$HOME/.gob/engine"
  fi
  if [ -n "$_cli_default" ] && [ -f "$_cli_default/manifest/enforcement.tsv" ]; then
    GOBLIN_ENGINE="$_cli_default"
    MANIFEST="$GOBLIN_ENGINE/manifest/enforcement.tsv"
  else
    MANIFEST="$SELF_DIR/../manifest/enforcement.tsv"
  fi
fi
[ -f "$MANIFEST" ] || {
  g_err "no manifest at $MANIFEST"
  g_err "no manifest at any of: \$SOURCE (${SOURCE:-unset}), $ENGINE_CHAIN_VENDORED (absent), $SELF_DIR/../manifest/enforcement.tsv"
  exit 2
}

# ---- the library (batch 2b-ii) -----------------------------------------------
# The OFF-by-default row set lives in manifest/library.tsv next to the resolved manifest.
# Its rows are NOT executed by a default run: the runner above reads $MANIFEST only. The
# library is shipped data (a moved row keeps its full check text and remedy — nothing is
# deleted or commented out, and no check function is removed from this verifier); a repo
# turns a row ON by writing its id (the row's `enable` column) into its local override
# .gob/manifest/enforcement.local.tsv, which batch 3 wires into the run. Until then the
# library is a discovery surface: what exists, is held back, and how to enable each row.
MANIFEST_DIR=$(dirname "$MANIFEST")
LIBRARY_FILE="$MANIFEST_DIR/library.tsv"
[ -f "$LIBRARY_FILE" ] || LIBRARY_FILE=""

# ---- the repo-local override (batch 3): .gob/manifest/enforcement.local.tsv ----
# A repo turns a library row ON by writing that row's exact line (the snippet `gob verify
# --library` prints) into .gob/manifest/enforcement.local.tsv, which is VERSIONED WITH THE REPO
# (under $ROOT, not the engine). A local row behaves exactly like a matrix row: PASS, FAIL
# (its remedy: line is printed from this file), or SKIP (reported not-applicable). The file is
# OPTIONAL: absent means the default set only, and nothing is said about it.
#
# THE HONESTY GATE (the product's core rule: a repo must not be able to certify a rule nothing
# verifies). A local entry is REFUSED - exit 3, with a named remedy - when it names a row id the
# engine has no check for, or when its check cannot produce a verdict. Both are handled in
# setup_local_override below, before any row runs: a false green is the one failure this
# product must never produce. RUN_MANIFEST is $MANIFEST until a local override merges rows in.
LOCAL_FILE="$ROOT/.gob/manifest/enforcement.local.tsv"
[ -f "$LOCAL_FILE" ] || LOCAL_FILE=""
LOCAL_IDS=""
RUN_MANIFEST="$MANIFEST"

INSTALLED="$ROOT/.gob/installed.json"

# engine_block_field <key> — one field of installed.json's engine: block (empty if absent).
engine_block_field() {
  [ -f "$INSTALLED" ] || return 0
  g_json_object "$INSTALLED" engine | awk -F'\t' -v k="$1" '$1==k {print $2; exit}'
}

# ---- the engine mode (W1 §2.2) ----------------------------------------------
#   vendored (the default): the engine resolved inside the repo (or --source pinned it)
#     and installed.json records the payload. The install-record and procedure rows
#     behave exactly as before W1.
#   global: the engine resolved OUTSIDE the repo (engine_dir:, GOBLIN_ENGINE_DIR or
#     ~/.goblin/engine), or installed.json's own engine: block says mode=global - a repo
#     whose engine: block says global is global even if a vendored payload is still on
#     disk mid-migration (W3's three-verify sequence). The repo-local clauses keep
#     hashing what IS recorded; absence of engine files is not drift; a repo with no
#     install record at all is not born RED.
ENGINE_MODE="vendored"
[ -n "$GOBLIN_ENGINE" ] && ENGINE_MODE="global"
_em=$(engine_block_field mode)
[ "$_em" = "global" ] && ENGINE_MODE="global"
export ENGINE_MODE

# ---- manifest integrity (exit 3 before any check runs) ----------------------
manifest_check() {
  local rc=0
  awk -F'\t' 'NR>1 && $6=="" {print "row " $1 " has no check and no advisory label"; bad=1} END{exit bad}' "$MANIFEST" || rc=3
  awk -F'\t' 'NR>1 {if (seen[$1]++) {print "duplicate id " $1; bad=1}} END{exit bad}' "$MANIFEST" || rc=3
  return $rc
}
manifest_check || { g_err "manifest is broken (exit 3)"; exit 3; }

if [ "$LIST" -eq 1 ]; then
  awk -F'\t' 'NR>1 {printf "%-7s %-7s %-9s %s\n", $1, $2, $4, $3}' "$MANIFEST"
  exit 0
fi

# --library: the discovery surface for the extend mechanism. It lists what the default run
# does NOT check, so a green run is never mistaken for the whole story. Each line: the row id,
# its one-line purpose (the rule cell), and the exact line that turns it on.
if [ "$LIBRARY_LIST" -eq 1 ]; then
  if [ -z "$LIBRARY_FILE" ]; then
    g_err "no library.tsv next to $MANIFEST - this engine ships no off-by-default row set"
    exit 2
  fi
  g_info "the library: $(awk -F'\t' 'NR>1 && $1!="" {n++} END{print n+0}' "$LIBRARY_FILE") off-by-default row(s) - NOT run by a default verify."
  g_info "enable a row by pasting its line below into .gob/manifest/enforcement.local.tsv (repo-local, committed with the repo)."
  printf '\n'
  awk -F'\t' 'NR>1 && $1!="" {
    printf "%-7s %s\n", $1, $3
    printf "          paste this line into .gob/manifest/enforcement.local.tsv:\n"
    printf "          %s\t%s\t%s\t%s\t%s\t%s\t%s\n", $1, $2, $3, $4, $5, $6, $7
  }' "$LIBRARY_FILE"
  exit 0
fi

# --only must name rows the manifest actually has: a typo used to select nothing, emit no
# rows and exit 0, turning a pipeline gate into a no-op (D15).
if [ -n "$ONLY" ]; then
  UNKNOWN=""
  for want in $(printf '%s' "$ONLY" | tr ',' ' '); do
    [ -n "$want" ] || continue
    _hit=0
    awk -F'\t' -v x="$want" 'NR>1 && $1==x {f=1} END{exit !f}' "$MANIFEST" && _hit=1
    if [ "$_hit" -eq 0 ] && [ -n "$LOCAL_FILE" ]; then
      awk -F'\t' -v x="$want" '$1==x {f=1} END{exit !f}' "$LOCAL_FILE" && _hit=1
    fi
    [ "$_hit" -eq 1 ] || UNKNOWN="$UNKNOWN $want"
  done
  [ -z "$UNKNOWN" ] || { g_err "--only names id(s) in neither the manifest nor the local override:$UNKNOWN"; exit 2; }
  # A valid id that is SOURCE-scope (PR-01..PR-04) selects no target row: the run emits
  # nothing and exits 0, which is the same no-op gate D15 closed for a typo (F2-6).
  TARGET_ROWS=0
  for want in $(printf '%s' "$ONLY" | tr ',' ' '); do
    [ -n "$want" ] || continue
    awk -F'\t' -v x="$want" 'NR>1 && $1==x && $2=="target" {f=1} END{exit !f}' "$MANIFEST" \
      && TARGET_ROWS=1
    if [ "$TARGET_ROWS" -eq 0 ] && [ -n "$LOCAL_FILE" ]; then
      awk -F'\t' -v x="$want" '$1==x && $2=="target" {f=1} END{exit !f}' "$LOCAL_FILE" \
        && TARGET_ROWS=1
    fi
  done
  if [ "$TARGET_ROWS" -eq 0 ]; then
    g_err "--only $ONLY selects no target-scope row, so this run would execute nothing and"
    g_err "report success. Source-scope rows (PR-*) run in tests/run-tests.sh, not here."
    exit 2
  fi
fi

if [ ! -f "$CONFIG" ]; then
  # Not installed. When PWD is not the target's own project root, the FIRST suggestion is to
  # go to the repo you meant, and the install command is named second WITH its target spelled
  # out — an out-of-context `goblin-install --target $PWD` is how a scratch directory gets
  # initialized by accident (review 2 §1.6). Exit stays 2.
  if [ "$ROOT" != "$PWD" ]; then
    g_err "not installed: $CONFIG is absent — and $PWD is not the installed repo ($ROOT)."
    g_err "fix: cd to your project repo, then re-run gob verify."
    g_err "    (installing here would initialize $PWD: npx @techgoblin/gobstack init)"
  else
    g_err "not installed: $CONFIG is absent. Run: npx @techgoblin/gobstack init   # or: gob init, inside $ROOT"
  fi
  exit 2
fi

# Root vs git toplevel. find_installed_root resolves the CONFIG lookup correctly, but the
# rows that shell out to git run in $ROOT and git resolves that to the ENCLOSING repo when
# the target is not a repository of its own: a nested target then reports the outer repo's
# index (30 "dirty entries" that belong to the outer repo) instead of its own state (F2-1).
# Refuse up front, with the reason, rather than print a number about the wrong tree.
ROOT_PHYS=$(cd "$ROOT" && pwd -P)
GIT_TOP=$(cd "$ROOT" && git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$GIT_TOP" ] && [ "$GIT_TOP" != "$ROOT_PHYS" ]; then
  g_err "target $ROOT_PHYS is inside the git repository $GIT_TOP but is not a repository of"
  g_err "its own. CM-03 GT-03 SP-02 PG-01 PG-03 DS-01 and HP-05 shell out to git,"
  g_err "and git would resolve every one of them to $GIT_TOP - the numbers would describe the"
  g_err "outer repo, not this target."
  g_err "fix: cd $ROOT_PHYS && git init   (make the target its own repo), or move it out of"
  g_err "     $GIT_TOP."
  exit 2
fi

ARCHIVE=$(g_agents_read "$CONFIG" archive)
MAX_DIRTY=$(g_agents_read "$CONFIG" max_dirty)
ADV_CEILING=$(g_agents_read "$CONFIG" advisory_ceiling)
HARNESS_DIR_RAW=$(g_agents_read "$CONFIG" harness_dir)
SCAFFOLD_CHECKS=$(g_agents_read "$CONFIG" scaffold_checks)
PRACTICE=$(g_expand_tilde "$(g_agents_read "$CONFIG" practice)")
PRACTICE_SHA=$(g_unquote "$(g_agents_read "$CONFIG" practice_sha256)")
[ -n "$MAX_DIRTY" ] || MAX_DIRTY=0
[ -n "$ADV_CEILING" ] || ADV_CEILING=10
[ -n "$HARNESS_DIR_RAW" ] || HARNESS_DIR_RAW=checks
# A config installed before this key existed declares no harness expectation: keep the old
# skip behaviour rather than failing an adopted repo on an upgrade.
[ -n "$SCAFFOLD_CHECKS" ] || SCAFFOLD_CHECKS=no

# The feature map (G1). feature_map: EMPTY is the meaningful state, not a broken config: a
# fresh install has no map and the two FM rows must SKIP with that reason (the replay.commit:
# "" shape, docs/LIMITS.md #11). source_root: is what an entry path resolves against.
FEATURE_MAP=$(g_agents_read "$CONFIG" feature_map)
SOURCE_ROOT=$(g_unquote "$(g_agents_read "$CONFIG" source_root)")
[ -n "$SOURCE_ROOT" ] || SOURCE_ROOT=.
VERIFY_DOCTOR=$(g_unquote "$(g_agents_read "$CONFIG" verify_doctor)")
export FEATURE_MAP SOURCE_ROOT VERIFY_DOCTOR

# The reference corpus (P15, RC-01..RC-04). `reference_manifest:` is the ONE state that may SKIP
# with a reason: a repo with no reference corpus must not be born RED (the feature_map: shape),
# and RC-01/RC-02/RC-04 skip for exactly that reason. A key that IS declared but whose file is
# missing or unparseable is a FAIL, deliberately, so losing the manifest cannot read as "no
# corpus" (the FM-01 declared-map-absent shape). These rows are builtins and not shell one-liners
# for this reason alone: the runner gives only a builtin exit 2/3 (see the dispatch below), so a
# one-liner could never report "not applicable yet" without failing the run.
# `quarantine_root:` is the quarantine directory of the playbook's S5 - outside the repo by
# design - and no row reads it; it is declared so the procedure has a machine-readable anchor
# instead of a path in prose (it ships empty here, the way feature_map: does).
REFERENCE_MANIFEST=$(g_unquote "$(g_agents_read "$CONFIG" reference_manifest)")
export REFERENCE_MANIFEST


if [ -d "$ROOT/$HARNESS_DIR_RAW" ]; then
  export GOBLIN_HARNESS_DIR="$ROOT/$HARNESS_DIR_RAW"
  export GOBLIN_HARNESS_REL="$HARNESS_DIR_RAW"
  export GOBLIN_HARNESS_STATE=present
else
  export GOBLIN_HARNESS_DIR=""
  export GOBLIN_HARNESS_REL="$HARNESS_DIR_RAW"
  # 'absent' = scaffold_checks is yes and the declared harness dir is missing -> FAIL.
  # 'none'   = scaffold_checks is no, so there is no harness dir to assert -> SKIP (D7).
  if [ "$SCAFFOLD_CHECKS" = "yes" ]; then
    export GOBLIN_HARNESS_STATE=absent
  else
    export GOBLIN_HARNESS_STATE=none
  fi
fi

# ---- the report format (collapsed listing) ------------------------------------
# The default listing is one line per row: PASS payloads collapse to (ok) and long ADV
# sentences fold to the report width; --verbose (or --only) prints every payload
# full-width. The lib's row printers read these.
# The report width and the manifest path the row printers read (the remedy lookup is
# manifest-driven: the tsv is the source of truth, the engine only renders it).
export GOB_VERIFY_VERBOSE="$VERBOSE"
export GOB_REPORT_COLS="${COLUMNS:-100}"
[ "$GOB_REPORT_COLS" -ge 40 ] 2>/dev/null || GOB_REPORT_COLS=100
export _GOB_MANIFEST="$MANIFEST"
export GOBLIN_ROOT="$ROOT"
export GOBLIN_CONFIG="$CONFIG"

# ---- the security surface (SC-01..SC-09) and the perf baseline (PF-01) -----------------------
# Every one of these is DECLARED in .gob/goblin.yaml. A stack-specific rule guessed from the
# files on disk is how a matrix starts lying; a declared key that is absent is a skip with a
# reason, never a silent pass.
SEC_GITIGNORE_FAMILY=$(g_agents_read "$CONFIG" security.gitignore_family)
SEC_BUILD_OUTPUT=$(g_agents_read "$CONFIG" security.build_output)
SEC_WRITE_ROUTES=$(g_agents_read "$CONFIG" security.write_routes)
PERF_METRIC=$(g_agents_read "$CONFIG" perf.metric)
PERF_CMD=$(g_agents_read "$CONFIG" perf.cmd)
PERF_BASELINE_COMMIT=$(g_unquote "$(g_agents_read "$CONFIG" perf.baseline_commit)")
PERF_BASELINE_VALUE=$(g_agents_read "$CONFIG" perf.baseline_value)
PERF_MEASURED=$(g_unquote "$(g_agents_read "$CONFIG" perf.measured)")
PERF_HOST_GATE=$(g_agents_read "$CONFIG" perf.host_gate)
export SEC_GITIGNORE_FAMILY SEC_BUILD_OUTPUT
export SEC_WRITE_ROUTES PERF_METRIC PERF_CMD PERF_BASELINE_VALUE PERF_HOST_GATE

# Whole days between an ISO date and today, or empty when the date does not parse on this host
# (`date -d` is GNU; the row FAILS rather than assuming, because an unreadable date is not a
# fresh record).
age_days() {
  local then_s now_s
  then_s=$(date -u -d "$1" +%s 2>/dev/null) || return 1
  now_s=$(date -u +%s)
  printf '%s' "$(( (now_s - then_s) / 86400 ))"
}

# The source files a secret-shaped search should look at. The vendored harness (.gob,
# .hermes), the build output and dependencies are excluded: SC-03 must not match the row text
# that describes it.
sc_sources() {
  ( cd "$ROOT" && grep -rniE "$1" \
      --include='*.ts' --include='*.tsx' --include='*.js' --include='*.jsx' \
      --include='*.mjs' --include='*.cjs' --include='*.vue' --include='*.svelte' . 2>/dev/null \
      | grep -vE '(^|/)(\.next|node_modules|\.gob|\.hermes|dist|build|out|coverage)/' || true )
}

only_selected() {
  [ -z "$ONLY" ] && return 0
  case ",$ONLY," in *",$1,"*) return 0 ;; esac
  return 1
}

# ---- part mapping: a row id's prefix names the part a row belongs to ---------
row_part() {
  case "$1" in
    HP-*) echo handoff ;;
    SP-*) echo spec ;;
    GT-01|GT-02|GT-03) echo gate ;;
    GT-04|GT-05) echo ratchet ;;
    HS-01|HS-03) echo gate ;;
    HS-02) echo replay ;;
    PG-*) echo pr-gate ;;
    # SK-04 rides the `skills` part: its artifact is the shipped skills, and an explicit
    # --opt-out skills disables that part. The CORE tier (.gob/skills/) is vendored on
    # every install (GAP-2), so the row runs by default and only an explicit opt-out skips it.
    # (v3: the part was named `playbooks` for the manifest that indexed the cut skills; the
    # rail follows its list — manifest/playbooks.tsv is gone.)
    SK-04) echo skills ;;
    # SK-01 rides the same part. The core tier gives it subjects on every install — it no
    # longer has to skip on a default (no .hermes tier) repo.
    SK-01) echo skills ;;
    # SK-02 keys off the same part; it hashes the .gob/skills/ core tier too.
    SK-02) echo skills ;;
    *) echo "" ;;
  esac
}

# ============================================================== builtins ======
# Each builtin prints its detail and returns 0 pass | 1 fail | 2 advisory | 3 skip.

# The install-record rows (W1 §2.5). IN-01 and IN-04 were shell one-liners over
# .gob/installed.json; the engine.mode=global clause needs engine logic (a global,
# declaration-only repo has NO install record and must SKIP with the reason, never be
# born RED - the D8/FM-01 shape), so the one-liners move into builtins that keep the
# same clauses and gain the mode check. In vendored mode they are exactly the old cells.
check_in_01() {
  if [ "$ENGINE_MODE" = "global" ] && [ ! -s "$INSTALLED" ]; then
    printf 'global engine mode — no per-repo install record\n'
    return 3
  fi
  [ -s "$INSTALLED" ] && grep -q '"version"' "$INSTALLED" \
    && { printf 'the install record exists and names its version\n'; return 0; }
  # IN-01 recovery line (review 1, scope 4): the record is corrupt or missing; name the two
  # restores. The matrix's remedy: line rides under the payload via g_fail.
  printf 'installed.json is absent or records no version\n'
  printf 'recover: git checkout -- .gob/installed.json, or re-run npx @techgoblin/gobstack init --write to re-install\n'
  return 1
}

# g_installed_files_strict <installed.json> — only the entries of the `files:` MAP. The
# line-oriented engine-block reader (g_json_object) also matches the `engine:` block's
# "key": "value" pairs (W1 §2.2), which IN-04 must never read as pre-existing files.
g_installed_files_strict() {
  awk '
    /^  "files": \{[[:space:]]*\},?$/ { next }
    /^  "files": \{/ { f = 1; next }
    f && /^  \},$/ { f = 0 }
    f && /^    "/ {
      line = $0
      sub(/^    "/, "", line)
      p = line; sub(/".*/, "", p)
      h = line; sub(/[^"]*"[[:space:]]*:[[:space:]]*"/, "", h); sub(/".*/, "", h)
      print p "\t" h
    }
  ' "$1"
}

# g_json_object_strict <installed.json> <object-name> — g_json_object, hardened for the
# engine-block record (W1 §2.2): an EMPTY object (`"refused": {}`) opens and closes on
# the same line, so the reader must not treat the NEXT block's `"key": "value"` pairs
# as this object's (IN-04 read the engine block's `mode`/`engine_dir` as vanished
# pre-existing files).
g_json_object_strict() {
  awk -v name="$2" '
    index($0, "\"" name "\"") && /:[[:space:]]*\{/ {
      if ($0 ~ /\{[[:space:]]*\}/) next          # empty object: nothing inside
      inf = 1; next
    }
    inf && /^[[:space:]]*\}/ { inf = 0 }
    inf && /"/ {
      line = $0
      sub(/^[[:space:]]*"/, "", line)
      p = line; sub(/".*/, "", p)
      h = line; sub(/^[^"]*"[[:space:]]*:[[:space:]]*"/, "", h); sub(/".*/, "", h)
      if (p != "") print p "\t" h
    }
  ' "$1"
}

check_in_04() {
  if [ "$ENGINE_MODE" = "global" ] && [ ! -s "$INSTALLED" ]; then
    printf 'global engine mode — no per-repo install record\n'
    return 3
  fi
  local p h n=0 bad=0 files
  files=$(g_installed_files_strict "$INSTALLED" | cut -f1)
  while IFS=$'\t' read -r p h; do
    [ -n "$p" ] || continue
    n=$((n + 1))
    if [ ! -e "$ROOT/$p" ]; then printf 'pre-existing file vanished: %s\n' "$p"; bad=1; continue; fi
    if printf '%s\n' "$files" | grep -qxF "$p"; then
      printf 'pre-existing file was taken over by the install: %s\n' "$p"; bad=1
    fi
  done < <(g_json_object_strict "$INSTALLED" refused)
  printf '%d pre-existing file(s) left untouched\n' "$n"
  [ "$bad" -eq 0 ]
}

check_in_02() {
  # The W1 semantic split (§2.2). Clause 1 - the per-repo mode: hash every recorded file,
  # the practice pin rides along - is byte-for-byte what this row has always done, and a
  # fresh install keeps it (installed.json carries no engine: block).
  # Clause 2 - engine.mode=global with file entries remaining: hash what IS recorded;
  # an entry under the engine paths (.gob/bin, .gob/manifest, .gob/bans) that is
  # still present is hashed too
  # (harmless), and one that is MISSING is not drift - the engine is no longer the repo's.
  # Clause 3 - global with no file entries: the declaration + practice pin only; never
  # FAIL for absence of install artifacts (a declaration-only repo is not born RED).
  # The engine hash itself is printed in the footer on every run (see the footer, below);
  # this row proves the REPO-LOCAL bytes, and a global engine answers elsewhere.
  local p h cur n=0 bad=0 pin="" detail=""
  local DRIFTED=""
  while IFS=$'\t' read -r p h; do
    [ -n "$p" ] || continue
    if [ "$ENGINE_MODE" = "global" ]; then
      case "$p" in
        .gob/bin/*|.gob/manifest/*|.gob/bans/*|.gob/skills/*)
          [ -e "$ROOT/$p" ] || continue ;;   # engine removed by design: not drift
        # W4a (§5.3/§5.2): the procedure tier is EMITTED per platform, not carried in the
        # repo - a recorded .hermes/skills/ file absent from disk is the tier living at its
        # emitted paths, not drift. A copy that IS present must still hash true (a stale or
        # hand-edited shadow is exactly what the drift check exists to surface).
        .hermes/skills/*)
          [ -e "$ROOT/$p" ] || continue ;;
      esac
    fi
    # W6 neutral-first: an EXPLICIT --skills no re-install removes the recorded skill files
    # by design (the record follows the switch). Their absence on a record whose options now
    # say skills=no is the documented opt-out, not drift - the same clause W4a wrote for the
    # global tier, scoped to the record's own declared choice.
    case "$p" in
      .hermes/skills/*) [ -e "$ROOT/$p" ] || [ "$(g_installed_scalar_options "$INSTALLED" skills)" = "yes" ] || continue ;;
    esac
    n=$((n + 1))
    cur=$(g_sha256_file "$ROOT/$p")
    if [ "$cur" != "$h" ]; then
      printf 'drift: %s recorded %s now %s\n' "$p" "$h" "$cur"
      DRIFTED="$p"
      bad=1
    fi
  done < <(g_installed_files_strict "$INSTALLED")
  if [ "$ENGINE_MODE" = "global" ] && [ "$n" -eq 0 ]; then
    detail="0 repo-local files hashed (global engine mode)"
  else
    [ "$n" -gt 0 ] || { printf 'installed.json lists no files\n'; return 1; }
  fi
  # The practice pin rides on this row (R6 section 2.1 requires the pin; section 5 has no row of
  # its own for it). Both are the same statement: a recorded hash still matches the file on disk.
  local pin=""
  if [ -n "$PRACTICE" ] && [ -n "$PRACTICE_SHA" ]; then
    if [ ! -e "$PRACTICE" ]; then
      printf 'practice standard not found: %s\n' "$PRACTICE"; bad=1; pin=" | practice missing"
    else
      cur=$(g_sha256_file "$PRACTICE")
      if [ "$cur" != "$PRACTICE_SHA" ]; then
        printf 'practice standard edited: %s\n  recorded %s\n  now      %s\n' "$PRACTICE" "$PRACTICE_SHA" "$cur"
        # The remedy, in the place the operator actually meets the failure. The pin exists to
        # catch a SILENT edit, so re-pinning is a deliberate act: one explicit command, which
        # prints the old and new hash (docs/GUIDE.md, "An edited standard is not a dead end").
        printf '  if the edit is yours and intended, re-pin it deliberately:\n'
        printf '    goblin-install --target %s --re-pin   # from the gobstack checkout/install tree\n' "$ROOT"
        bad=1; pin=" | practice EDITED"
      else
        pin=" | practice pin ok"
      fi
    fi
  fi
  if [ "$ENGINE_MODE" = "global" ] && [ "$n" -eq 0 ]; then
    printf '%s%s\n' "$detail" "${pin:+ | ${pin# | }}"
    [ "$bad" -eq 0 ]
    return
  fi
  printf '%d installed files hashed%s\n' "$n" "$pin"
  # IN-02 recovery line (review 1, scope 4): a drift FAIL carries the exact restore commands,
  # naming the drifted file the payload above reported. Sits between the row's own lines and
  # the summary; g_fail appends the matrix's remedy: line under the whole payload.
  if [ "$bad" -ne 0 ] && [ -n "$DRIFTED" ]; then
    printf 'recover: git checkout -- %s, or re-run npx @techgoblin/gobstack init --write to re-install\n' "$DRIFTED"
  fi
  [ "$bad" -eq 0 ]
}

check_hp_03() {
  # Every gate-bearing line inside the HANDOFF's `Gates` section carries `measured <date>`.
  # Anchored on the gate names the AGENTS.md gob block DECLARES (GT-01's source of truth), not on
  # a hardcoded keyword list: the shipped gates are named `commit` and `todo_ceiling`, and the
  # old list `(tsc|build|hex|safelist|n/n)` matched neither, so on a fresh install the only line
  # it could see was the template's own "Example of the required form" prose. Measured at
  # 43f7f69: strip the date from the REAL gate line -> PASS; strip it from the example -> FAIL.
  # The row was testing the template, not the artifact (G8-2).
  #
  # A gate line is a line inside the section that carries `=` and either names a declared gate or
  # carries a gate-shaped number. A line whose text says "example of the required form" is
  # template prose, not a gate number, and is skipped. n == 0 is a FAIL: a Gates section with no
  # gate line at all (which is what is left when only the example remains) is not a green row.
  local names out rc n detail
  names=$(g_agents_gates "$CONFIG" | cut -f1 | tr '\n' ' ')
  names=${names% }
  rc=0
  out=$(awk -v names="$names" '
    function hasname(line, k,   i, a, m, pat) {
      # Portability (BSD catch, 2026-10-06): the split pattern must be a STRING, not a
      # regex literal. In /[^A-Za-z0-9_./-]+/ the third slash ENDS the regex, so the
      # macOS BWK awk dies with a syntax error ("nonterminated character class") before
      # reading a single line; gawk accepts it. A string pattern means the same thing
      # everywhere. (No apostrophes here: this program is a single-quoted shell string.)
      pat = "[^A-Za-z0-9_./-]+"
      m = split(line, a, pat)
      for (i = 1; i <= m; i++) if (a[i] == k) return 1
      return 0
    }
    BEGIN {
      bad = 0; n = 0
      m = split(names, dn, " ")
      for (i = 1; i <= m; i++) if (dn[i] != "") decl[dn[i]] = 1
    }
    # Portability (clean-room catch, 2026-10-05): the Debian default awk (mawk) has no
    # interval expressions ({2,3}) — the header rule matched nothing and HP-03 went red on
    # every fresh Debian install. The hash-header variants are spelled out as two pattern
    # statements, and the date as repeated [0-9] groups. (No apostrophes here: this
    # program is a single-quoted shell string.)
    tolower($0) ~ /^###[[:space:]]+[^[:alpha:]]*gates?([^[:alpha:]]|$)/ { g = 1; next }
    tolower($0) ~ /^##[[:space:]]+[^[:alpha:]]*gates?([^[:alpha:]]|$)/ { g = 1; next }
    g && (/^###[[:space:]]/ || /^##[[:space:]]/ || /^#[[:space:]]/) { g = 0 }
    !g { next }
    tolower($0) ~ /example of the required form/ { next }
    $0 !~ /=/ { next }
    {
      hit = 0
      if ($0 ~ /(tsc|build|hex|safelist|[0-9]+\/[0-9]+)[^=]*=/) hit = 1
      if (!hit) for (k in decl) if (hasname($0, k)) { hit = 1; break }
      if (hit) {
        n++
        if ($0 !~ /measured [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) {
          print "a gate line carries no measured date: " $0
          bad = 1
        }
      }
    }
    END {
      if (n == 0) {
        print "no gate line inside the Gates section (declared gates: " (names == "" ? "none" : names) ")"
        bad = 1
      }
      printf "#count %d\n", n
      exit bad
    }
  ' "$ROOT/HANDOFF.md") || rc=$?
  n=$(printf '%s\n' "$out" | sed -n 's/^#count //p')
  detail=$(printf '%s\n' "$out" | grep -v '^#count ' || true)
  if [ "$rc" -ne 0 ]; then printf '%s\n' "$detail"; return 1; fi
  printf '%d gate line(s) inside the Gates section, each with a measured date%s\n' \
    "${n:-0}" "${names:+ (anchored on the declared gate name(s): $names)}"
  return 0
}

check_hp_05() {
  local tok found=0 head
  head=$(cd "$ROOT" && git rev-parse HEAD 2>/dev/null)
  for tok in $(grep -oE '[0-9a-f]{7,40}' "$ROOT/HANDOFF.md" 2>/dev/null | sort -u); do
    ( cd "$ROOT" && git rev-parse --verify --quiet "$tok^{commit}" >/dev/null 2>&1 ) || continue
    ( cd "$ROOT" && git merge-base --is-ancestor "$tok" HEAD 2>/dev/null ) || continue
    printf 'names %s (ancestor of HEAD %s)\n' "$tok" "${head:0:7}"
    found=1
    break
  done
  [ "$found" -eq 1 ] || printf 'HANDOFF.md names no commit that exists in this repo\n'
  [ "$found" -eq 1 ]
}

check_gt_01() {
  # Every `- name:` under `gates:` is a DECLARED gate, and every declared gate must carry a
  # `cmd:`. Counting only the name+cmd PAIRS (what this row did) let a gate lose its `cmd:` -
  # deleted, blanked or re-indented - and the row still reported the survivors as
  # `1 declared gate(s)`: the gate vanished in silence (G8-3). The name reader is the one that
  # keeps it visible, so the missing `cmd:` is a FAIL here, not a pass.
  local n=0 bad=0 name cmd
  while IFS=$'\t' read -r name cmd; do
    [ -n "$name" ] || continue
    n=$((n + 1))
    if [ -z "$cmd" ]; then
      printf 'declared gate "%s" has no cmd - it is declared and never runs\n' "$name"
      bad=1
    fi
  done < <(g_agents_gates "$CONFIG")
  [ "$n" -ge 1 ] || { printf 'no gate declared in %s\n' "$CONFIG"; return 1; }
  [ "$bad" -eq 0 ] || return 1
  printf '%d declared gate(s), each with a cmd\n' "$n"
  return 0
}

# run the declared gates; optionally write the one-line measured numbers
# GT-02 stderr (review 2, scope 2): a gate that fails with nothing on screen (`cmd: false`,
# exit 127) fails in silence. The LAST ~20 lines of the failing gate's combined output are
# kept in GT02_TAIL, and the row's FAIL payload carries them indented under the FAIL line,
# attributed to the gate that produced them. The counts line and every other row's payload
# are untouched (byte-stable where no gate fails).
GT02_TAIL=""
run_gates() {
  local write_line="$1" name cmd rc bad=0 line="" out
  GT02_TAIL=""
  while IFS=$'\t' read -r name cmd; do
    [ -n "$name" ] || continue
    out=$( cd "$ROOT" && bash -c "$cmd" 2>&1 )
    rc=$?
    line="$line $name=$rc"
    if [ "$rc" -ne 0 ]; then
      printf 'gate %s: %s -> exit %d\n' "$name" "$cmd" "$rc"
      bad=1
      local tail_lines
      tail_lines=$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n 20)
      if [ -n "$tail_lines" ]; then
        if [ -n "$GT02_TAIL" ]; then GT02_TAIL="$GT02_TAIL
"; fi
        GT02_TAIL="${GT02_TAIL}gate ${name} output (last 20 lines):"
        while IFS= read -r tl; do
          GT02_TAIL="$GT02_TAIL
  $tl"
        done <<EOF_TAIL
$tail_lines
EOF_TAIL
      else
        [ -n "$GT02_TAIL" ] && GT02_TAIL="$GT02_TAIL
"
        GT02_TAIL="${GT02_TAIL}gate ${name} printed nothing on stdout or stderr before exit ${rc} (a silent failure - the command itself is the diagnostic)"
      fi
    fi
  done < <(g_agents_gates "$CONFIG")
  if [ "$write_line" = "yes" ]; then
    local rname rcmd rval
    rname=$(g_agents_read "$CONFIG" ratchet.name)
    rcmd=$(g_agents_read "$CONFIG" ratchet.cmd)
    if [ -n "$rname" ] && [ -n "$rcmd" ]; then
      rval=$( cd "$ROOT" && bash -c "$rcmd" 2>/dev/null | tr -d '[:space:]' )
      line="$line · $rname $rval (ceiling $(g_agents_read "$CONFIG" ratchet.ceiling))"
    fi
    printf '%s · measured %s\n' "${line# }" "$(date +%F)" > "$ROOT/.gob/last-gate-line"
    cat "$ROOT/.gob/last-gate-line"
  fi
  return $bad
}

check_gt_02() {
  local _s=0
  run_gates yes || _s=$?
  if [ "$_s" -ne 0 ] && [ -n "$GT02_TAIL" ]; then printf '%s\n' "$GT02_TAIL"; fi
  return "$_s"
}

check_gt_04() {
  local n c ceil
  n=$(g_agents_read "$CONFIG" ratchet.name)
  c=$(g_agents_read "$CONFIG" ratchet.cmd)
  ceil=$(g_agents_read "$CONFIG" ratchet.ceiling)
  [ -n "$n" ] || { printf 'ratchet.name missing\n'; return 1; }
  [ -n "$c" ] || { printf 'ratchet.cmd missing\n'; return 1; }
  case "$ceil" in ''|*[!0-9]*) printf 'ratchet.ceiling must be numeric, got %s\n' "$ceil"; return 1 ;; esac
  printf 'ratchet %s ceiling %s\n' "$n" "$ceil"
  return 0
}

check_gt_05() {
  local n c ceil val old prev="" note=""
  n=$(g_agents_read "$CONFIG" ratchet.name)
  c=$(g_agents_read "$CONFIG" ratchet.cmd)
  ceil=$(g_agents_read "$CONFIG" ratchet.ceiling)
  [ -n "$n" ] && [ -n "$c" ] || { printf 'no ratchet declared - skipped\n'; return 3; }
  val=$( cd "$ROOT" && bash -c "$c" 2>/dev/null | tr -d '[:space:]' )
  case "$val" in ''|*[!0-9]*) printf 'ratchet cmd produced a non-number: %s\n' "$val"; return 1 ;; esac
  if [ -f "$ROOT/.gob/ratchet-last" ]; then prev=$(cat "$ROOT/.gob/ratchet-last"); fi
  if [ -n "$prev" ] && [ "$prev" -lt "$val" ]; then
    note="old $prev + $((val - prev)) new = $val"
  else
    note="$n $val (ceiling $ceil)"
  fi
  printf '%s\n' "$val" > "$ROOT/.gob/ratchet-last"
  if [ "$val" -gt "$ceil" ]; then printf '%s over ceiling %s\n' "$note" "$ceil"; return 1; fi
  printf '%s\n' "$note"
  return 0
}

check_hs_01() {
  local d="$GOBLIN_HARNESS_DIR" f base asserting=0 reporting=0 bad=0
  if [ -z "$d" ]; then
    # A declared harness dir that is missing is a FAIL when scaffold_checks is yes; when it is
    # no the row skips with a reason. Keying the skip off the PATH alone let a one-line config
    # edit switch both HS rows off (D7).
    if [ "$GOBLIN_HARNESS_STATE" = "absent" ]; then
      printf 'harness_dir %s is declared and scaffold_checks is yes, but the directory is absent\n' \
        "$GOBLIN_HARNESS_REL"
      return 1
    fi
    printf 'no harness dir (%s absent, scaffold_checks is no) - nothing to assert\n' \
      "$GOBLIN_HARNESS_REL"
    return 3
  fi
  for f in "$d"/*; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    if grep -q 'assert(' "$f" && grep -q 'process\.exit' "$f"; then
      asserting=$((asserting + 1))
    else
      reporting=$((reporting + 1))
      printf 'not an asserting harness (report utility): %s\n' "$base"
    fi
  done
  printf '%d asserting harness(es), %d report utility(ies)\n' "$asserting" "$reporting"
  [ "$asserting" -gt 0 ] || { printf 'harness dir %s holds no asserting harness\n' "$GOBLIN_HARNESS_REL"; bad=1; }
  [ "$bad" -eq 0 ]
}

check_hs_02() {
  local env cmd commit d tmp bad=0 f rc base name qname pat
  env=$(g_agents_read "$CONFIG" replay.env)
  cmd=$(g_agents_read "$CONFIG" replay.cmd)
  commit=$(g_unquote "$(g_agents_read "$CONFIG" replay.commit)")
  [ -n "$env" ] || { printf 'replay.env not declared\n'; return 1; }
  [ -n "$cmd" ] || { printf 'replay.cmd not declared\n'; return 1; }
  # Z1-4: the DECLARED command has to be what runs the harness. Until this fix it was read only
  # to assert it was non-empty, and the loop below ran `node <file>` itself - so the command and
  # its `{name}` placeholder were decorative (`grep -rn '{name}' tests/` was 0 hits, and setting
  # `replay.cmd: false` changed no verdict). A documented mechanism that never executes is the
  # same species as the regression this repo already shipped once.
  #   * a command that does not interpolate {name} cannot be running the harness it names, so
  #     nothing is replayed and "every harness was RED" would be a statement about a command
  #     that never ran one (the defanged-probe shape, docs/LIMITS.md #28/W5-12);
  #   * a command that cannot be executed at all (exit 126/127) FAILS rather than counting as a
  #     RED harness - otherwise a typo'd interpreter would make every harness look proven.
  pat='{name}'
  case "$cmd" in
    *"$pat"*) ;;
    *) printf 'replay.cmd declares no %s: %s\n' "$pat" "$cmd"
       printf 'the declared command cannot be running the harness it names, so nothing was replayed\n'
       return 1 ;;
  esac
  if [ -z "$commit" ] || ! git -C "$ROOT" rev-parse --verify --quiet "$commit^{commit}" >/dev/null; then
    printf 'no pinned pre-change commit yet (replay.commit empty or unknown) - REPLAY not provable\n'
    return 3
  fi
  d="$GOBLIN_HARNESS_DIR"
  if [ -z "$d" ]; then
    if [ "$GOBLIN_HARNESS_STATE" = "absent" ]; then
      printf 'harness_dir %s is declared and scaffold_checks is yes, but the directory is absent\n' \
        "$GOBLIN_HARNESS_REL"
      return 1
    fi
    printf 'no harness dir to replay\n'; return 3
  fi
  tmp=$(mktemp -d)
  if ! git -C "$ROOT" worktree add -q --detach "$tmp/wt" "$commit" 2>/dev/null; then
    rm -rf "$tmp"; printf 'cannot create a worktree at %s\n' "$commit"; return 1
  fi
  mkdir -p "$tmp/wt/$GOBLIN_HARNESS_REL"
  cp -a "$d/." "$tmp/wt/$GOBLIN_HARNESS_REL/"
  for f in "$tmp/wt/$GOBLIN_HARNESS_REL"/*.mjs; do
    [ -e "$f" ] || continue
    base=$(basename "$f")
    name=${base%.mjs}
    # Z2-3: the name is SHELL-QUOTED before it is substituted, because it now reaches a shell.
    # This row runs the DECLARED command rather than `node "$f"` (Z1-4), so a file in the harness
    # dir - a name the row does not control - is part of the command text `bash -c` parses.
    # Unquoted, a name carrying `;`, `#`, a space or a glob was read as shell syntax: measured, a
    # file named `z2;true;#.mjs` produced TWO commands and the trailing `true` decided the exit
    # code. The outcome stayed fail-closed (a GREEN "harness" makes the row FAIL), but it is the
    # same surface class as the G8-1 injection, so it is quoted rather than only documented.
    qname=$(printf '%q' "$name")
    ( cd "$tmp/wt" && env "$env"="$commit" bash -c "${cmd//$pat/$qname}" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
      0)
        printf '%s was GREEN on the pre-change tree %s - proves nothing\n' "$base" "${commit:0:7}"
        bad=1
        ;;
      126|127)
        printf '%s: the declared replay.cmd could not be executed (exit %d): %s\n' "$base" "$rc" "$cmd"
        bad=1
        ;;
    esac
  done
  git -C "$ROOT" worktree remove --force "$tmp/wt" >/dev/null 2>&1
  rm -rf "$tmp"
  [ "$bad" -eq 0 ] && printf 'every harness was RED at %s (run as: %s)\n' "${commit:0:7}" "$cmd"
  return $bad
}

check_cm_03() {
  local n
  n=$(cd "$ROOT" && git status --porcelain 2>/dev/null | wc -l | tr -d '[:space:]')
  printf '%s dirty entr(y|ies), max_dirty %s\n' "$n" "$MAX_DIRTY"
  [ "$n" -le "$MAX_DIRTY" ]
}

check_pg_01() {
  local f head n=0 bad=0
  for f in "$ROOT"/reviews/*.md; do
    [ -e "$f" ] || continue
    n=$((n + 1))
    head=$(sed -n 's/^head:[[:space:]]*//p' "$f" | head -n 1)
    if [ -z "$head" ]; then printf '%s: no head: line\n' "$(basename "$f")"; bad=1; continue; fi
    if ! ( cd "$ROOT" && git rev-list --all 2>/dev/null | grep -q "^$head" ); then
      printf '%s: head %s is not in git rev-list --all\n' "$(basename "$f")" "$head"
      bad=1
    fi
  done
  printf '%d review note(s)\n' "$n"
  [ "$bad" -eq 0 ]
}

check_pg_02() {
  local f stakes lanes n=0 bad=0
  for f in "$ROOT"/reviews/*.md; do
    [ -e "$f" ] || continue
    n=$((n + 1))
    stakes=$(sed -n 's/^stakes:[[:space:]]*//p' "$f" | head -n 1)
    case "$stakes" in
      S[0-4]) ;;
      *) printf '%s: stakes must be S0..S4, got "%s"\n' "$(basename "$f")" "$stakes"; bad=1; continue ;;
    esac
    case "$stakes" in
      S2|S3|S4)
        if ! awk '/^checks-run:/{c=1;next} c&&/^[a-z-]+:/{c=0} c&&NF{found=1} END{exit !found}' "$f"; then
          printf '%s: stakes %s requires a non-empty checks-run: section\n' "$(basename "$f")" "$stakes"
          bad=1
        fi ;;
    esac
    case "$stakes" in
      S3|S4)
        lanes=$(sed -n 's/^lanes:[[:space:]]*//p' "$f" | head -n 1)
        if [ -z "$lanes" ] || [ "$lanes" = "1" ]; then
          printf '%s: stakes %s requires a second lane (lanes: 2 or more)\n' "$(basename "$f")" "$stakes"
          bad=1
        fi ;;
    esac
  done
  printf '%d review note(s) classified\n' "$n"
  [ "$bad" -eq 0 ]
}

check_pg_03() {
  local f base head rec now n=0 bad=0
  for f in "$ROOT"/reviews/*.md; do
    [ -e "$f" ] || continue
    n=$((n + 1))
    base=$(sed -n 's/^base:[[:space:]]*//p' "$f" | head -n 1)
    head=$(sed -n 's/^head:[[:space:]]*//p' "$f" | head -n 1)
    rec=$(sed -n 's/^patch-id:[[:space:]]*//p' "$f" | head -n 1)
    if [ -z "$base" ] || [ -z "$head" ] || [ -z "$rec" ]; then
      printf '%s: needs base:, head: and patch-id:\n' "$(basename "$f")"; bad=1; continue
    fi
    now=$( cd "$ROOT" && git diff "$base".."$head" 2>/dev/null | git patch-id --stable 2>/dev/null | awk '{print $1}' )
    if [ "$now" != "$rec" ]; then
      printf '%s: recorded patch-id %s, now %s\n' "$(basename "$f")" "$rec" "${now:-<none>}"
      bad=1
    fi
  done
  printf '%d review note(s) patch-id checked\n' "$n"
  [ "$bad" -eq 0 ]
}

hash_runtime_data() {
  local p h out=""
  while read -r p; do
    [ -n "$p" ] || continue
    h=$(g_sha256_file "$ROOT/$p")
    out="$out$p=$h "
  done < <(g_agents_list "$CONFIG" runtime_data)
  printf '%s' "${out% }"
}

check_ds_01() {
  local before after bad=0 p
  # Clause the row's own rule states and the old body dropped: every declared path must be
  # git-ignored, or it is fixture, not runtime data (D12).
  while read -r p; do
    [ -n "$p" ] || continue
    ( cd "$ROOT" && git check-ignore -q -- "$p" ) \
      || { printf 'runtime_data path is not git-ignored: %s\n' "$p"; bad=1; }
  done < <(g_agents_list "$CONFIG" runtime_data)
  before=$(hash_runtime_data)
  run_gates no >/dev/null 2>&1
  after=$(hash_runtime_data)
  printf 'before=%s\nafter=%s\n' "$before" "$after" > "$ROOT/.gob/.ds-report"
  if [ "$before" != "$after" ]; then
    printf 'a gate run wrote runtime data: %s -> %s\n' "$before" "$after"
    return 1
  fi
  # Declaring nothing is not a pass: it is an unexercised rule, and it is reported as one.
  [ -n "$before" ] || { printf 'no runtime_data declared\n'; return 2; }
  [ "$bad" -eq 0 ] || return 1
  printf 'unchanged: %s\n' "$before"
  return 0
}

check_ds_02() {
  [ -f "$ROOT/.gob/.ds-report" ] || { printf 'no DS-01 report in this run\n'; return 1; }
  local b a
  b=$(sed -n 's/^before=//p' "$ROOT/.gob/.ds-report")
  a=$(sed -n 's/^after=//p' "$ROOT/.gob/.ds-report")
  [ "$b" = "$a" ] || { printf 'before/after differ\n'; return 1; }
  [ -f "$ROOT/.gob/last-gate-line" ] || { printf 'no gate line to annotate\n'; return 0; }
  local line
  line=$(tr -d '\n' < "$ROOT/.gob/last-gate-line")
  printf '%s · runtime_data %s\n' "$line" "${b:-<none declared>}" > "$ROOT/.gob/last-gate-line"
  printf 'snapshot %s\n' "${b:-<none declared>}"
  return 0
}

check_sc_02() {
  # Clause 1 is a file rule; clause 2 is BEHAVIOURAL - it asks git's own matcher, so an ignore
  # rule that looks right but does not match still fails. `git check-ignore -q` accepts exactly
  # one pathname, so the body loops.
  local miss="" p
  if [ ! -f "$ROOT/.gitignore" ]; then
    if [ -f "$ROOT/package.json" ]; then
      printf 'no .gitignore in a repo with a package.json\n'; return 1
    fi
    printf 'no .gitignore and no package.json - there is no dependency surface here to protect\n'
    return 3
  fi
  grep -qE '^[[:space:]]*\.env(\*|/)?[[:space:]]*$' "$ROOT/.gitignore" \
    || miss="no bare .env rule"
  if [ -d "$ROOT/.git" ]; then
    for p in .env .env.local .env.production; do
      ( cd "$ROOT" && git check-ignore -q "$p" ) || miss="$miss not-ignored:$p"
    done
  else
    miss="$miss no-git-repository"
  fi
  if [ -n "$miss" ]; then printf 'the secret family is not ignored:%s\n' "$miss"; return 1; fi
  printf 'the whole secret family is ignored (.env, .env.local, .env.production proved by git)\n'
  return 0
}

check_sc_03() {
  # Clause 1: a client-visible NAME that is secret-shaped. Clause 2: a known secret PREFIX in
  # real build output. The second clause is reported, never silently skipped: a repo with no
  # build output is told so on the line.
  local hits hits_all hits_n vs_keys vs_files out n=0 bad=0
  hits_all=$(sc_sources 'NEXT_PUBLIC_[A-Z0-9_]*(SECRET|TOKEN|KEY|PASSWORD|PASSWD|PRIVATE)')
  # W5-11: this line printed a CHARACTER count as a hit count - `${#hits}` on a multiline
  # string - so ONE matching line of 70 characters was reported as "70 client-visible
  # secret-shaped name(s)". The number is the count of matching LINES (capped at five lines of
  # evidence), which is what the word "name(s)" claims.
  hits_n=0
  [ -n "$hits_all" ] && hits_n=$(printf '%s\n' "$hits_all" | grep -c .)
  hits=$(printf '%s' "$hits_all" | head -n 5)
  if [ -n "$hits" ]; then
    printf 'client-visible secret-shaped name(s): %d\n%s\n' "$hits_n" "$hits"; bad=1
  fi
  out=""
  for d in $SEC_BUILD_OUTPUT; do
    [ -d "$ROOT/$d" ] || continue
    out="$out $(find "$ROOT/$d" -type f 2>/dev/null | head -n 200)"
  done
  for f in $out; do
    n=$((n + 1))
    grep -qE '(sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|AKIA[A-Z0-9]{16}|eyJ[A-Za-z0-9_-]{20,}\.)' "$f" 2>/dev/null \
      && { printf 'a secret-shaped literal is in build output: %s\n' "${f#"$ROOT"/}"; bad=1; }
  done
  if [ "$n" -eq 0 ]; then
    printf '%d client-visible secret-shaped name(s); no build output to scan for clause 2\n' "$hits_n"
  else
    printf '%d client-visible secret-shaped name(s); %d build-output file(s) scanned for secret literals\n' "$hits_n" "$n"
  fi
  [ "$bad" -eq 0 ]
}

check_sc_04() {
  # A JS-written cookie needs `secure` + `samesite` in the SAME statement; a server-side set
  # needs `httpOnly` + `sameSite`. Same-statement only: a write spread over three lines is not
  # seen, and the row says so rather than implying it read the statement.
  local js srv bad=0 n=0 line
  js=$(sc_sources 'document\.cookie[[:space:]]*=')
  srv=$(sc_sources '(cookies\(\)\.set\(|res\.cookie\(|NextResponse\.cookie\()')
  if [ -n "$js" ]; then
    while IFS= read -r line; do
      n=$((n + 1))
      printf '%s' "$line" | grep -qiE 'secure' || { printf 'a JS cookie write has no secure flag: %s\n' "$(printf '%s' "$line" | cut -d: -f1-2)"; bad=1; }
      printf '%s' "$line" | grep -qiE 'samesite' || { printf 'a JS cookie write has no samesite flag: %s\n' "$(printf '%s' "$line" | cut -d: -f1-2)"; bad=1; }
    done <<EOF
$js
EOF
  fi
  if [ -n "$srv" ]; then
    while IFS= read -r line; do
      n=$((n + 1))
      printf '%s' "$line" | grep -qiE 'httponly' || { printf 'a server cookie set has no httpOnly: %s\n' "$(printf '%s' "$line" | cut -d: -f1-2)"; bad=1; }
      printf '%s' "$line" | grep -qiE 'samesite' || { printf 'a server cookie set has no sameSite: %s\n' "$(printf '%s' "$line" | cut -d: -f1-2)"; bad=1; }
    done <<EOF
$srv
EOF
  fi
  printf '%d cookie write(s) checked; a JS-written cookie is readable by any script - reported, not failed\n' "$n"
  [ "$bad" -eq 0 ]
}

check_sc_05() {
  # Every write handler (POST|PUT|PATCH|DELETE) in the declared route dirs must CALL a validator,
  # or be named in .gob/boundary-waivers. Partial by design: it proves a validator is called,
  # not that the schema is right.
  local d f rel n=0 bad=0 w=0
  for d in $SEC_WRITE_ROUTES; do
    [ -d "$ROOT/$d" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      grep -qE 'export[[:space:]]+(async[[:space:]]+)?(function[[:space:]]+)?(const[[:space:]]+)?(POST|PUT|PATCH|DELETE)\b' "$f" || continue
      n=$((n + 1))
      rel="${f#"$ROOT"/}"
      if grep -qE 'safeParse|zod|valibot|yup|ajv|superstruct|validate\(' "$f"; then continue; fi
      if [ -f "$ROOT/.gob/boundary-waivers" ] && grep -qE "^[[:space:]]*${rel}([[:space:]]|$)" "$ROOT/.gob/boundary-waivers"; then
        w=$((w + 1)); continue
      fi
      printf 'a write handler validates nothing and is not waived: %s\n' "$rel"; bad=1
    done <<EOF
$(find "$ROOT/$d" -type f \( -name 'route.ts' -o -name 'route.js' -o -name 'route.tsx' \) 2>/dev/null)
EOF
  done
  printf '%d write handler(s), %d waived; %d dir(s) declared\n' "$n" "$w" "${#SEC_WRITE_ROUTES}"
  [ "$bad" -eq 0 ]
}

check_sc_06() {
  [ -f "$ROOT/package.json" ] || { printf 'no package.json - there is no dependency manifest to lock\n'; return 3; }
  local f found=""
  for f in package-lock.json pnpm-lock.yaml yarn.lock bun.lockb bun.lock; do
    [ -f "$ROOT/$f" ] && found="$f"
  done
  [ -n "$found" ] || { printf 'package.json is present with no lockfile beside it\n'; return 1; }
  if [ -d "$ROOT/.git" ]; then
    ( cd "$ROOT" && git ls-files --error-unmatch "$found" >/dev/null 2>&1 ) \
      || { printf '%s exists but is not tracked\n' "$found"; return 1; }
    printf '%s is present and tracked\n' "$found"
  else
    printf '%s is present; the tracked clause is ordered after `git init`\n' "$found"
  fi
  return 0
}

# check_in_03 — the manifest self-check, run against whichever manifest the engine
# actually resolved (W1 §2.5: the row's meaning is untouched, the hardcoded per-repo
# path input follows the chain §2.3). Same three clauses as the row always carried.
check_in_03() {
  local bad=0
  awk -F'\t' 'NR>1 && $6=="" {print "row " $1 " has no check and no advisory label"; bad=1} END{exit bad}' "$MANIFEST" || bad=1
  awk -F'\t' 'NR>1 && ($6=="advisory" && $4!="advisory") {print "row " $1 " is advisory-labelled but its check column claims enforcement"; bad=1} END{exit bad}' "$MANIFEST" || bad=1
  awk -F'\t' 'NR>1 && $4 !~ /^(script|lint|gate|advisory|test)$/ {print "row " $1 " has an enforced_by outside the closed enum: " $4; bad=1} END{exit bad}' "$MANIFEST" || bad=1
  [ "$bad" -eq 0 ] && { printf 'the manifest is complete: every rule carries a check or is advisory, inside the enum\n'; return 0; }
  return 1
}

# ---- W1 §2.5, the SK/automation split ----------------------------------------
# In global mode the procedure tier (skills) is served from the
# engine, not emitted in the repo - emission is W4's. Hashing a global copy from a repo's
# verify would make one machine's skill set answer for every repo, so the per-repo rows
# SKIP with that reason instead of FAILing on the absent copies. SK-03 runs unchanged:
# it reads the manifest, which resolves via the chain either way.

check_bn_00() {
  # The coherence row: the ban table and the matrix must agree in BOTH directions, every ban
  # must name a replacement, and the table must not be empty. IN-03's shape applied to
  # bans.tsv - a rule that lives only in a data file would otherwise be invisible to SK-03.
  local bans ban_ids row_ids id n bad=0
  # The ban table resolves through the engine chain (W1 §2.3): vendored first, then the
  # declared/global engine - the fallback slots into chain steps 2/3/4 where it used to
  # hardcode two of them.
  bans="$ROOT/.gob/manifest/bans.tsv"
  [ -f "$bans" ] || bans="${GOBLIN_ENGINE:-$SELF_DIR/../..}/manifest/bans.tsv"
  [ -f "$bans" ] || bans="$SELF_DIR/../manifest/bans.tsv"
  [ -f "$bans" ] || { printf 'no ban table found (manifest/bans.tsv)\n'; return 1; }
  n=$(awk -F'\t' 'NR>1 && $1!="" {n++} END{print n+0}' "$bans")
  [ "$n" -gt 0 ] || { printf 'the ban table is empty - a ban list that enforces nothing\n'; return 1; }
  awk -F'\t' 'NR>1 && $1!="" && $5=="" {print "ban " $1 " names no replacement"; bad=1} END{exit bad}' "$bans" \
    || bad=1
  ban_ids=$(awk -F'\t' 'NR>1 && $1!="" {print $1}' "$bans" | sort)
  row_ids=$(awk -F'\t' 'NR>1 && $1 ~ /^BN-/ && $1 != "BN-00" {print $1}' "$MANIFEST" | sort)
  while read -r id; do
    [ -n "$id" ] || continue
    printf '%s\n' "$ban_ids" | grep -qx "$id" || { printf 'enforcement row %s has no ban in the table\n' "$id"; bad=1; }
  done <<EOF
$row_ids
EOF
  while read -r id; do
    [ -n "$id" ] || continue
    printf '%s\n' "$row_ids" | grep -qx "$id" || { printf 'ban %s has no enforcement row\n' "$id"; bad=1; }
  done <<EOF
$ban_ids
EOF
  [ "$bad" -eq 0 ] || return 1
  printf '%d ban(s), each with an enforcement row and a named replacement\n' "$n"
  return 0
}

check_bn_run() {
  # One ban, through the resolved engine. rc: 0 pass | 1 fail | 3 skip | anything else fail
  # closed (the engine's own exit 2 = the table is missing/empty, which is not a pass).
  # W1 §2.5: the engine is <resolved engine>/bin/goblin-bans (chain §2.3). The hard-FAIL
  # stays for the vendored mode; in global mode the engine's own existence was already
  # checked at resolution (§1.2 item 4), so an absent ban engine is a config error, but it
  # is still reported FAIL-closed here rather than silently skipped - the ban lane must
  # never read clean because a binary went missing.
  local id="$1" engine out rc detail
  engine="$ROOT/.gob/bin/goblin-bans"
  if [ ! -f "$engine" ] && [ -n "$GOBLIN_ENGINE" ]; then engine="$GOBLIN_ENGINE/bin/goblin-bans"; fi
  [ -f "$engine" ] || { printf 'the ban engine is not installed: .gob/bin/goblin-bans\n'; return 1; }
  out=$( cd "$ROOT" && bash "$engine" --only "$id" 2>&1 ); rc=$?
  detail=$(printf '%s\n' "$out" | grep -vE '^      [0-9]+ passed' \
             | sed 's/^\(PASS\|FAIL\|SKIP\|ADV\)  \{1,\}[A-Z0-9-]*  *//' | sed '/^$/d' \
             | head -n 3 | tr '\n' ' ')
  printf '%s\n' "${detail:-no detail}"
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
    3) return 3 ;;
    *) return 1 ;;
  esac
}

check_bn_01() { check_bn_run BN-01; }
check_bn_02() { check_bn_run BN-02; }
check_bn_03() { check_bn_run BN-03; }
check_bn_05() { check_bn_run BN-05; }
# G6 section B.2: the Electron failure surface, as bans. Same engine, same exit contract, same
# SKIP-when-unlisted behaviour - the mechanism is G5's, only the patterns are new.
check_bn_06() { check_bn_run BN-06; }
check_bn_07() { check_bn_run BN-07; }
check_bn_08() { check_bn_run BN-08; }
check_bn_09() { check_bn_run BN-09; }

check_pf_01() {
  # The perf NUMBER lives in `ratchet:` (GT-04/GT-05 unchanged). This row is the other half: the
  # baseline must name the commit it was measured on, so raising the ceiling cannot silently
  # become never measuring again. An empty metric or an empty baseline means "not measured yet"
  # - a skip with that reason, because a row that is RED on every fresh install teaches people
  # to ignore it.
  local rname bad=0
  rname=$(g_agents_read "$CONFIG" ratchet.name)
  [ -n "$PERF_METRIC" ] || {
    printf 'no perf metric is declared (perf.metric is empty). The ratchet still carries\n%s; declare metric/cmd here the day you pick one\n' "${rname:-nothing}"
    return 3
  }
  [ -n "$PERF_BASELINE_COMMIT" ] || {
    printf 'no perf baseline recorded yet: run `%s` on a pinned commit, then write\nperf.baseline_commit, perf.baseline_value, perf.measured and the matching ratchet ceiling\n' "$PERF_CMD"
    return 3
  }
  [ "$PERF_METRIC" = "$rname" ] \
    || { printf 'perf.metric (%s) and ratchet.name (%s) disagree - the budget and the measurement are two different numbers\n' "$PERF_METRIC" "$rname"; bad=1; }
  case "$PERF_BASELINE_VALUE" in
    ''|*[!0-9]*) printf 'perf.baseline_value is not a number: %s\n' "${PERF_BASELINE_VALUE:-<empty>}"; bad=1 ;;
  esac
  case "$PERF_MEASURED" in
    ????-??-??) : ;;
    *) printf 'perf.measured is not an ISO date: %s\n' "${PERF_MEASURED:-<empty>}"; bad=1 ;;
  esac
  ( cd "$ROOT" && git cat-file -e "${PERF_BASELINE_COMMIT}^{commit}" 2>/dev/null ) \
    || { printf 'perf.baseline_commit does not resolve: %s\n' "$PERF_BASELINE_COMMIT"; bad=1; }
  ( cd "$ROOT" && git merge-base --is-ancestor "$PERF_BASELINE_COMMIT" HEAD 2>/dev/null ) \
    || { printf 'perf.baseline_commit is not an ancestor of HEAD: %s - the number describes a tree nobody has\n' "$PERF_BASELINE_COMMIT"; bad=1; }
  # The cross-check G8-6b asked for: the budget and the measurement must be the SAME number.
  # Without it a one-line `ceiling:` raise passed while the row printed `baseline_value 0 ...
  # (ceiling 100000)` - the contradiction on its own passing line, seen by nothing. The ceiling
  # is anchored on the recorded baseline; raising it is what "I never measured again" looks like.
  local ceiling
  ceiling=$(g_agents_read "$CONFIG" ratchet.ceiling)
  case "$ceiling" in
    ''|*[!0-9]*) printf 'ratchet.ceiling is not a number: %s\n' "${ceiling:-<empty>}"; bad=1 ;;
    *)
      if [ "$ceiling" != "$PERF_BASELINE_VALUE" ]; then
        printf 'ratchet.ceiling (%s) and perf.baseline_value (%s) disagree - the budget no longer matches the measurement it was anchored on\n' \
          "$ceiling" "$PERF_BASELINE_VALUE"
        bad=1
      fi ;;
  esac
  [ "$bad" -eq 0 ] || return 1
  printf '%s = %s measured %s on %s (ceiling %s), host gate: %s\n' \
    "$PERF_METRIC" "$PERF_BASELINE_VALUE" "$PERF_MEASURED" "$PERF_BASELINE_COMMIT" \
    "$(g_agents_read "$CONFIG" ratchet.ceiling)" "${PERF_HOST_GATE:-none}"
  return 0
}

# check_sk_proc_skip — the shared global-mode clause for SK-01/SK-02/SK-04 (§2.5): in
# global mode the procedure tier is emitted per platform (not carried in this repo)
# (emission is W4's), so the row SKIPs with that reason instead of FAILing on the absent
# copies. Vendored mode returns 1: the caller's own logic runs.
sk_proc_skip() {
  if [ "$ENGINE_MODE" = "global" ]; then
    printf 'procedure tier emitted per platform (not carried in this repo)\n'
    return 0
  fi
  return 1
}

# sk01_cell — SK-01's original check cell (name + description frontmatter), kept verbatim;
# the builtin only adds the mode clause (the spec's §2.5 names SK-01 alongside SK-02/SK-04:
# without it, a global repo with no skills passes the loop vacuously — a green that proves
# nothing, exactly the shape §2.5 exists to kill).
sk01_cell() {
  n=0; for f in .gob/skills/*/SKILL.md .hermes/skills/*/SKILL.md; do [ -e "$f" ] || continue; n=$((n+1)); head -n 1 "$f" | grep -qx -- '---' || exit 1; awk 'NR==1{next} /^---/{exit} /^name:/{a=1} /^description:/{b=1} END{exit !(a&&b)}' "$f" || exit 1; done; [ "$n" -gt 0 ] || { echo "no installed skill found"; exit 1; }; exit 0
}

check_sk_01() {
  sk_proc_skip && return 3
  ( cd "$ROOT" && sk01_cell )
}

# sk04_cell — SK-04's original check cell. Kept verbatim so the row's declared text and
# its executed behaviour stay the same thing; the builtin only adds the mode clause.
sk04_cell() {
  n=0; for f in .gob/skills/*/SKILL.md .hermes/skills/*/SKILL.md; do [ -e "$f" ] || continue; n=$((n+1)); grep -q "^## What this cannot see" "$f" || { echo "missing cannot-see section: $f"; exit 1; }; done; [ "$n" -gt 0 ] || { echo "no installed skill found"; exit 1; }; exit 0
}

check_sk_04() {
  sk_proc_skip && return 3
  ( cd "$ROOT" && sk04_cell )
}

check_sk_02() {
  sk_proc_skip && return 3
  local p h cur n=0 bad=0
  while IFS=$'\t' read -r p h; do
    case "$p" in .gob/skills/*|.hermes/skills/*) ;; *) continue ;; esac
    n=$((n + 1))
    cur=$(g_sha256_file "$ROOT/$p")
    [ "$cur" = "$h" ] || { printf 'skill drift: %s\n' "$p"; bad=1; }
  done < <(g_installed_files "$INSTALLED")
  printf '%d installed skill file(s) hashed\n' "$n"
  [ "$n" -gt 0 ] || { printf 'no skills recorded in installed.json\n'; return 1; }
  [ "$bad" -eq 0 ]
}

check_sk_03() {
  local k free plural
  # A malformed ceiling is a FAIL, not an advisory: `[ n -le ten ]` returns 2, and the runner
  # reads 2 as ADV, so a broken cap used to disappear into the advisory count instead of
  # stopping the run (V1/G8-5).
  case "$ADV_CEILING" in
    ''|*[!0-9]*) printf 'advisory_ceiling is not a number: %s\n' "${ADV_CEILING:-<empty>}"; return 1 ;;
  esac
  # Count what the run counts: a row is advisory if its check column says so OR its enforced_by
  # does (an advisory-labelled row can carry a builtin marker in its check column). Counting only
  # the literal column printed 7 while the summary printed 8 (D13).
  k=$(awk -F'\t' 'NR>1 && ($4=="advisory" || $6=="advisory") {n++} END{print n+0}' "${RUN_MANIFEST:-$MANIFEST}")
  # The REMAINING BUDGET is reported, not implied: the ceiling is the one scarce resource a rule
  # author spends. A count with
  # no arithmetic leaves the next author to work it out (G8-5).
  free=$((ADV_CEILING - k))
  plural=""; [ "$free" -eq 1 ] || plural="s"
  if [ "$free" -gt 0 ]; then
    printf 'advisory %d of ceiling %d (%d free slot%s)\n' "$k" "$ADV_CEILING" "$free" "$plural"
  elif [ "$free" -eq 0 ]; then
    printf 'advisory %d of ceiling %d (0 free slots: the next advisory row FAILs)\n' "$k" "$ADV_CEILING"
  else
    printf 'advisory %d of ceiling %d (over by %d: this FAILs)\n' "$k" "$ADV_CEILING" "$((-free))"
  fi
  [ "$k" -le "$ADV_CEILING" ]
}

check_cl_02() {
  # The archive flag is a switch with a contract, so it must be checkable (D6 - the old body
  # printed a sentence and returned 0 in both branches, so the row could never be RED).
  # Two falsifiable clauses: the value must be a boolean, and it must agree with what the
  # install recorded - otherwise flipping `archive:` by hand silently waives the checks.
  case "$ARCHIVE" in
    true|false) ;;
    *) printf 'archive: must be true or false, got "%s"\n' "${ARCHIVE:-<empty>}"; return 1 ;;
  esac
  local recorded
  recorded=$(sed -n 's/.*"archive"[[:space:]]*:[[:space:]]*\([a-z]*\).*/\1/p' "$INSTALLED" 2>/dev/null | head -n 1)
  if [ -n "$recorded" ] && [ "$recorded" != "$ARCHIVE" ]; then
    printf 'archive: is %s in %s but the install recorded %s - the waiver was flipped by hand\n' \
      "$ARCHIVE" "$CONFIG" "$recorded"
    return 1
  fi
  if [ "$ARCHIVE" = "true" ]; then
    printf 'archive: true (matches the install record) - HP-*/GT-*/SP-* skipped, no HANDOFF or gates required\n'
  else
    printf 'archive: false - the full requirement applies\n'
  fi
  return 0
}

# ---- the feature map (G1): FM-01, FM-02, VA-01 ----------------------------------------------
# P6 authors the map (skills/goblin-feature-map); these rows keep it honest. All three SKIP
# with a reason when their declared config value is empty, because a fresh install has neither
# a map nor a doctor and must not be born RED (the D8 shape).

fm_readme() {  # absolute path of the declared map README
  case "$FEATURE_MAP" in
    /*) printf '%s' "$FEATURE_MAP" ;;
    *)  printf '%s' "$ROOT/$FEATURE_MAP" ;;
  esac
}
fm_dir() { dirname "$(fm_readme)"; }

# The map directory RELATIVE to $ROOT. The entry-path list lives inside the map, so a token
# written there would otherwise be found by FM-02's own grep and read as "still resolves" even
# after the route it names was renamed - the exclusion is what makes the row able to go RED.
fm_dir_rel() {
  local d; d=$(fm_dir)
  case "$d" in
    "$ROOT"/*) printf '%s' "${d#"$ROOT"/}" ;;
    *) printf '%s' "$d" ;;
  esac
}

# fm_frontmatter <file> - the body of the leading --- block.
fm_frontmatter() {
  awk 'BEGIN{fm=0} /^---[[:space:]]*$/ {fm++; if (fm==1) next; else exit} fm==1 {print}' "$1"
}

# fm_entry_paths <file> - one declared entry path per line.
fm_entry_paths() {
  fm_frontmatter "$1" | awk '
    /^entry_paths:/      { inb = 1; next }
    inb && /^  - /       { v = $0; sub(/^  - /, "", v); sub(/[[:space:]]+$/, "", v); print v; next }
    inb && !/^[[:space:]]/ { inb = 0 }
  '
}

# fm_h2_ok <file> - exactly the four contract H2s, in order. The third is a PREFIX match: the
# map names the project's own harness ("Driving it with <harness>"), so a literal would make the
# rule un-portable.
fm_h2_ok() {
  local n=0 ok=1 line
  while IFS= read -r line; do
    n=$((n + 1))
    case "$n" in
      1) [ "$line" = "Sub-features" ] || ok=0 ;;
      2) [ "$line" = "How to get to it (user POV)" ] || ok=0 ;;
      3) case "$line" in "Driving it with "*) ;; *) ok=0 ;; esac ;;
      4) [ "$line" = "Gotchas" ] || ok=0 ;;
      *) ok=0 ;;
    esac
  done < <(grep -n '^## ' "$1" | sed 's/^[0-9]*:## //; s/[[:space:]]*$//')
  [ "$n" -eq 4 ] && [ "$ok" -eq 1 ]
}

# fm_feature_files - every feature file. The README is the index, not a feature.
fm_feature_files() {
  local f
  for f in "$(fm_dir)"/*.md; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in README.md) continue ;; esac
    printf '%s\n' "$f"
  done
}

check_fm_01() {
  [ -n "$FEATURE_MAP" ] || {
    printf 'feature_map: is empty - this state is UNREACHABLE through `gob init --write`, which always declares a live map; the repo was installed by the low-level goblin-install, or hand-edited. There is nothing to index.\n'
    return 3
  }
  local readme; readme=$(fm_readme)
  if [ ! -f "$readme" ]; then
    printf 'feature_map: %s does not exist - a declared map that is absent is a hole, not a skip\n' "$FEATURE_MAP"
    return 1
  fi
  local dir f b link slug eps n=0 bad=0
  dir=$(fm_dir)
  # index hygiene: every feature file is linked, every relative link resolves
  while IFS= read -r f; do
    n=$((n + 1)); b=$(basename "$f")
    grep -qF "](./$b)" "$readme" \
      || { printf 'feature file %s is not linked from %s\n' "$b" "$FEATURE_MAP"; bad=1; }
  done < <(fm_feature_files)
  [ "$n" -gt 0 ] \
    || { printf '%s indexes no feature file - an empty map is a hole, not a pass\n' "$FEATURE_MAP"; bad=1; }
  while IFS= read -r link; do
    [ -e "$dir/$link" ] || { printf '%s links %s, which does not resolve\n' "$FEATURE_MAP" "$link"; bad=1; }
  done < <(sed -n 's/.*](\.\/\([^)]*\.md\)).*/\1/p' "$readme")
  # the per-feature entry contract
  while IFS= read -r f; do
    b=$(basename "$f")
    slug=$(fm_frontmatter "$f" | sed -n 's/^feature:[[:space:]]*//p' | head -n 1)
    [ "$slug" = "${b%.md}" ] \
      || { printf '%s: feature: is "%s" but the filename stem is "%s"\n' "$b" "${slug:-<absent>}" "${b%.md}"; bad=1; }
    eps=$(fm_entry_paths "$f" | grep -c . || true)
    [ "${eps:-0}" -ge 1 ] \
      || { printf '%s: declares no entry_paths: - nothing for FM-02 to resolve\n' "$b"; bad=1; }
    fm_h2_ok "$f" \
      || { printf '%s: the H2s are not the contract four, in order (Sub-features / How to get to it (user POV) / Driving it with <harness> / Gotchas)\n' "$b"; bad=1; }
  done < <(fm_feature_files)
  [ "$bad" -eq 0 ] || return 1
  printf '%s: %d feature file(s) indexed, each with the four-H2 contract and >=1 entry path\n' \
    "$FEATURE_MAP" "$n"
  return 0
}

check_fm_02() {
  [ -n "$FEATURE_MAP" ] || {
    printf 'feature_map: is empty - this state is UNREACHABLE through `gob init --write`, which always declares a live map; the repo was installed by the low-level goblin-install, or hand-edited. There are no entry paths to resolve.\n'
    return 3
  }
  local readme; readme=$(fm_readme)
  if [ ! -f "$readme" ]; then
    printf 'feature_map: %s does not exist - a declared map that is absent is a hole, not a skip\n' "$FEATURE_MAP"
    return 1
  fi
  local sr srpath reldir f b e v m t bad=0
  sr="$SOURCE_ROOT"
  case "$sr" in /*) srpath="$sr" ;; *) srpath="$ROOT/$sr" ;; esac
  reldir=$(fm_dir_rel)
  # W5-4: the search must not be satisfiable by the HARNESS ITSELF. `source_root: .` walked the
  # install, so a stub map (`entry_paths: [export]`) "resolved" to ./.gob/bin/goblin-verify and
  # both FM rows passed a map that only echoed the template. The harness's own directories
  # (.gob/, .hermes/), git's, and the declared harness_dir are skipped by name, and the map's
  # own directory is skipped by path - without that last one the map's own entry-path list
  # satisfies the search and the row could never go RED. What is still NOT excluded is stated in
  # docs/LIMITS.md #37: a token that occurs only in the target's own docs/, tests/ or build output
  # still reads as resolved, because those are the target's files and excluding them would be a
  # guess about a layout goblin-stack does not know.
  local exd=(--exclude-dir=.git --exclude-dir=.gob --exclude-dir=.hermes)
  case "$GOBLIN_HARNESS_REL" in
    ''|.|./) ;;
    *) exd+=(--exclude-dir="$(basename "$GOBLIN_HARNESS_REL")") ;;
  esac
  while IFS= read -r f; do
    b=$(basename "$f")
    v=$(fm_frontmatter "$f" | sed -n 's/^verified:[[:space:]]*//p' | head -n 1)
    while IFS= read -r e; do
      [ -n "$e" ] || continue
      m=$( cd "$ROOT" && grep -rlF "${exd[@]}" -- "$e" "$sr" 2>/dev/null \
             | grep -v -e "^$reldir/" -e "^\./$reldir/" | head -n 1 )
      if [ -z "$m" ]; then
        printf '%s: entry path "%s" no longer occurs in source under %s (the harness directories are not source)\n' "$b" "$e" "$sr"
        bad=1; continue
      fi
      [ -n "$v" ] || continue
      # Z1-6: "resolves" must not imply "is tracked". `git log -1 --format=%cs` prints nothing
      # for a file git cannot date, and the comparison below used to SKIP on that empty string -
      # so a map could claim `verified: 2020-01-01` and PASS while the source it names was never
      # committed (measured: map seeded, source uncommitted -> PASS). The date is this row's
      # whole claim, so an untracked resolved file is now a FAIL with the reason, not a skip.
      if ! ( cd "$ROOT" && git ls-files --error-unmatch -- "$m" >/dev/null 2>&1 ); then
        printf '%s: entry path "%s" resolves to %s, which git does not track - a verified: date cannot be checked against an uncommitted file\n' \
          "$b" "$e" "$m"
        bad=1; continue
      fi
      t=$( cd "$ROOT" && git log -1 --format=%cs -- "$m" 2>/dev/null )
      [ -n "$t" ] || continue
      if [ "$t" \> "$v" ]; then
        printf '%s: "%s" resolves to %s, last changed %s - after the map was verified %s\n' \
          "$b" "$e" "$m" "$t" "$v"
        bad=1
      fi
    done < <(fm_entry_paths "$f")
  done < <(fm_feature_files)
  [ "$bad" -eq 0 ] || return 1
  printf 'every declared entry path still resolves under %s, and none changed after its verified: date\n' "$sr"
  return 0
}

check_va_01() {
  [ -n "$VERIFY_DOCTOR" ] || {
    printf 'verify_doctor: is empty - no doctor is declared, so "the generated skill was executed once" is not provable here\n'
    return 3
  }
  # The DECLARED command, run the same way GT-02 runs a declared gate. It is never a string read
  # out of source (the v0.2 blocker): the config is the thing a human wrote on purpose.
  local out rc
  out=$( cd "$ROOT" && bash -c "$VERIFY_DOCTOR" 2>&1 ); rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'verify_doctor: "%s" -> exit %d\n%s\n' "$VERIFY_DOCTOR" "$rc" "$(printf '%s' "$out" | head -n 3)"
    return 1
  fi
  printf 'verify_doctor: "%s" -> exit 0\n' "$VERIFY_DOCTOR"
  return 0
}

# ---- the reference corpus (P15): RC-01..RC-04 ------------------------------------------------
# P15's machine half. All four read DECLARED values - `reference_manifest:` and the
# `security: build_output:` block SC-03 clause 2 already reads - and never infer a path from the
# stack. They are builtins because a shell one-liner cannot SKIP: the runner turns any non-zero
# shell exit into a FAIL, so a repo with no corpus would be born RED (see the dispatch below).

rc_path() {  # the declared manifest, as an absolute path
  case "$REFERENCE_MANIFEST" in
    /*) printf '%s' "$REFERENCE_MANIFEST" ;;
    *)  printf '%s' "$ROOT/$REFERENCE_MANIFEST" ;;
  esac
}

# rc_parse <mode> <manifest> — mode `entries` prints one "sha256<TAB>path" line per entry; mode
# `validate` prints one line per schema violation. Both exit 1 when the file cannot be read or is
# not the shape they expect, and both print to stdout so the caller can show the reason.
rc_parse() {
  python3 -c '
import json, re, sys
mode, path = sys.argv[1], sys.argv[2]
hex64 = re.compile(r"^[0-9a-fA-F]{64}$")
try:
    with open(path, encoding="utf-8", errors="replace") as fh:
        doc = json.load(fh)
except Exception as exc:
    sys.stdout.write("unparseable JSON: %s\n" % exc)
    sys.exit(1)
if not isinstance(doc, dict):
    sys.stdout.write("the manifest is not a JSON object\n")
    sys.exit(1)
entries = doc.get("entries")
if mode == "entries":
    if not isinstance(entries, list):
        sys.stdout.write("entries is not a list\n")
        sys.exit(1)
    for e in entries:
        if isinstance(e, dict):
            sys.stdout.write("%s\t%s\n" % (e.get("sha256", ""), e.get("path", "")))
    sys.exit(0)
bad = []
def want(cond, msg):
    if not cond:
        bad.append(msg)
want(doc.get("schema") == "reference-manifest/1", "schema is not reference-manifest/1")
gf = doc.get("generated_from")
want(isinstance(gf, str) and gf.strip() != "", "generated_from is empty")
app = doc.get("reference_app")
want(isinstance(app, dict), "reference_app is missing")
if isinstance(app, dict):
    for key in ("package", "version"):
        v = app.get(key)
        want(isinstance(v, str) and v.strip() != "", "reference_app.%s is empty" % key)
    want(bool(hex64.match(str(app.get("apk_sha256", "")))), "reference_app.apk_sha256 is not 64 hex")
want(isinstance(entries, list) and len(entries) > 0, "entries is empty")
if isinstance(entries, list):
    for i, e in enumerate(entries):
        if not isinstance(e, dict):
            bad.append("entry %d is not an object" % i)
            continue
        p = e.get("path")
        want(isinstance(p, str) and p.strip() != "", "entry %d: path is empty" % i)
        want(bool(hex64.match(str(e.get("sha256", "")))), "entry %d: sha256 is not 64 hex" % i)
        want(isinstance(e.get("bytes"), int) and not isinstance(e.get("bytes"), bool),
             "entry %d: bytes is not a number" % i)
    ec = doc.get("entry_count")
    want(isinstance(ec, int) and not isinstance(ec, bool) and ec == len(entries),
         "entry_count does not equal len(entries)")
for m in bad:
    sys.stdout.write("%s\n" % m)
sys.exit(1 if bad else 0)
' "$1" "$2"
}

# rc_build_output_files — every regular file under each declared build-output dir. The key is
# space-separated and a directory that does not exist is skipped, exactly as SC-03 clause 2 does.
rc_build_output_files() {
  local d
  for d in $SEC_BUILD_OUTPUT; do
    [ -d "$ROOT/$d" ] || continue
    find "$ROOT/$d" -type f 2>/dev/null
  done
}

# rc_in_build_output <abs path> — is that path inside one of the declared build-output dirs?
rc_in_build_output() {
  local p="$1" d
  for d in $SEC_BUILD_OUTPUT; do
    case "$p" in "$ROOT/$d"/*) return 0 ;; esac
  done
  return 1
}

check_rc_01() {
  # Four clauses. (1) `reference_manifest:` empty is the ONE skip, and it carries its reason.
  # (2) declared but missing or unparseable is a FAIL - losing the manifest must not read as "no
  # corpus". (3) any file under the declared build output whose sha256 appears in an entry's
  # sha256 fails, naming the path and the entry. (4) the manifest itself is not shippable.
  if [ -z "$REFERENCE_MANIFEST" ]; then
    printf 'reference_manifest: is empty - no reference corpus is declared, so there is nothing for a build to match against\n'
    return 3
  fi
  local mf; mf=$(rc_path)
  if [ ! -f "$mf" ]; then
    printf 'reference_manifest: %s does not exist - a declared corpus that is absent is a hole, not a skip\n' "$REFERENCE_MANIFEST"
    return 1
  fi
  local entries
  if ! entries=$(rc_parse entries "$mf"); then
    printf 'reference_manifest: %s is not parseable - a declared corpus that cannot be read is a FAIL\n' "$REFERENCE_MANIFEST"
    printf '%s\n' "$entries" | sed 's/^/  /'
    return 1
  fi
  local n_entries; n_entries=$(printf '%s\n' "$entries" | grep -c . || true)
  local bad=0 out_n=0 f h hit mh
  mh=$(g_sha256_file "$mf")
  # clause 4, both halves of "the manifest is not itself shippable": the declared path must not
  # live inside the build output, and no COPY of the manifest may sit there either - the manifest
  # is a listing of every corpus hash, so shipping it ships the corpus's shape.
  if rc_in_build_output "$mf"; then
    printf 'the reference manifest itself sits inside the declared build output: %s\n' "${mf#"$ROOT"/}"
    bad=1
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    out_n=$((out_n + 1))
    h=$(g_sha256_file "$f")
    if [ "$h" = "$mh" ]; then
      printf 'a copy of the reference manifest is in the build output: %s\n' "${f#"$ROOT"/}"
      bad=1
      continue
    fi
    hit=$(printf '%s\n' "$entries" | awk -F'\t' -v h="$h" '$1 == h { print $2; exit }')
    if [ -n "$hit" ]; then
      printf 'a reference-corpus payload is in the build output: %s (entry %s)\n' "${f#"$ROOT"/}" "$hit"
      bad=1
    fi
  done < <(rc_build_output_files)
  [ "$bad" -eq 0 ] || return 1
  if [ "$out_n" -eq 0 ]; then
    printf '%s entry/entries; no build output to scan (security: build_output: names no directory that exists)\n' "$n_entries"
  else
    printf '%s entry/entries; %s build-output file(s) hashed, none matches\n' "$n_entries" "$out_n"
  fi
  return 0
}

check_rc_02() {
  # The vacuous-pass guard: RC-01 cannot pass on a manifest that was authored weak. SKIPs with
  # RC-01's reason when the key is empty; a declared manifest that is absent or ill-shaped is a
  # FAIL, never a skip.
  if [ -z "$REFERENCE_MANIFEST" ]; then
    printf 'reference_manifest: is empty - there is no manifest to shape-check (RC-01 skips for the same reason)\n'
    return 3
  fi
  local mf; mf=$(rc_path)
  if [ ! -f "$mf" ]; then
    printf 'reference_manifest: %s does not exist - a declared manifest that is absent is a hole, not a skip\n' "$REFERENCE_MANIFEST"
    return 1
  fi
  local errs=""
  errs=$(rc_parse validate "$mf") && {
    printf '%s is shaped so RC-01 cannot pass vacuously (schema, provenance, non-empty entries, entry_count)\n' "$REFERENCE_MANIFEST"
    return 0
  }
  printf '%s is not a usable reference manifest:\n' "$REFERENCE_MANIFEST"
  printf '%s\n' "$errs" | sed 's/^/  /'
  return 1
}

check_rc_03() {
  # Two clauses over the LAB repo: every tracked path is inside the declared allowlist, and no
  # tracked file's sha256 equals a hash in a manifests/*.sha256. The manifest lists paths and
  # hashes, which the lab's own README permits - the check is about BYTES, so the manifest is
  # never read as a violation (its rows name files under the quarantine anchor, outside the repo).
  if [ ! -d "$ROOT/manifests" ]; then
    printf 'no manifests/ directory - this is not a lab repo with a reference corpus, so there are no tracked bytes to check\n'
    return 3
  fi
  local mfs; mfs=$(ls "$ROOT"/manifests/*.sha256 2>/dev/null || true)
  if [ -z "$mfs" ]; then
    printf 'manifests/ exists but holds no *.sha256 - a corpus manifest directory that cannot be read is a FAIL, not a skip\n'
    return 1
  fi
  local bad=0 p h m hashes="" n=0
  for m in $mfs; do
    hashes="$hashes$(awk '!/^#/ && NF >= 2 { print $1 }' "$m")"$'\n'
  done
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    n=$((n + 1))
    case "$p" in
      scripts/*|notes/*|manifests/*) continue ;;
      # The harness's own directories and the .gitignore block it appends are the install, not the
      # lab's content - the same exclusion FM-02 makes for the same reason (W5-4). That set is the
      # one the install contract creates: .gob/, .hermes/, the .gitignore block, the
      # declared harness_dir (checks/ by default), reviews/, and the CI scaffold .github/. A payload
      # hidden in any of them is still caught by clause 2 (the sha256 sweep below).
      .gob/*|.hermes/*|.gitignore|.github/*|reviews/*) continue ;;
      "${GOBLIN_HARNESS_REL:-checks}"/*) continue ;;
    esac
    case "$p" in
      */*) bad=1; printf 'a tracked path outside the lab allowlist (scripts/, notes/, manifests/, root docs): %s\n' "$p" ;;
      *.md) ;;  # a root-level doc
      *)   bad=1; printf 'a tracked path outside the lab allowlist (scripts/, notes/, manifests/, root docs): %s\n' "$p" ;;
    esac
  done < <( cd "$ROOT" && git ls-files )
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    h=$(g_sha256_file "$ROOT/$p")
    if printf '%s' "$hashes" | grep -qxF "$h"; then
      printf 'a reference-corpus payload is TRACKED in the lab repo: %s\n' "$p"
      bad=1
    fi
  done < <( cd "$ROOT" && git ls-files )
  [ "$bad" -eq 0 ] || return 1
  printf '%s tracked file(s): all inside the lab allowlist, none matching a corpus hash\n' "$n"
  return 0
}

check_rc_04() {
  # The acquisition record, and the weakest of the four: it proves a record EXISTS, never that
  # the number beside it came from the store. SKIPs when no manifest is declared; a manifest with
  # no header block is a FAIL.
  local mfs; mfs=$(ls "$ROOT"/manifests/*.sha256 2>/dev/null || true)
  if [ -z "$mfs" ]; then
    printf 'no manifests/*.sha256 - no acquisition record is declared, so there is none to read\n'
    return 3
  fi
  local bad=0 m hdr tgt src c64 apk apkh n=0
  for m in $mfs; do
    n=$((n + 1))
    hdr=$(awk '/^#/ { print; next } { exit }' "$m")
    if [ -z "$hdr" ]; then
      printf '%s: no header block - the acquisition record is absent\n' "${m#"$ROOT"/}"
      bad=1; continue
    fi
    tgt=$(rc_hdr_field "$hdr" target)
    src=$(rc_hdr_field "$hdr" source)
    c64=$(printf '%s\n' "$hdr" | grep -oiE '[0-9a-f]{64}' | head -n 1)
    # the header's own apk path
    apk=$(printf '%s' "$tgt" | grep -oiE '[A-Za-z0-9._-]+\.apk' | head -n 1)
    apkh=$(awk '!/^#/ && NF >= 2 { print $1 "\t" $2 }' "$m" | awk -F'\t' 'tolower($2) ~ /\.apk$/ { print; exit }')
    if [ -z "$tgt" ] || ! printf '%s' "$tgt" | grep -qE '[0-9]+\.[0-9]+'; then
      printf '%s: the header names no target slug + version (target: <file> <version>)\n' "${m#"$ROOT"/}"; bad=1
    fi
    if [ -z "$src" ] || ! printf '%s' "$src" | grep -qE '[A-Za-z0-9.-]+\.[A-Za-z]{2,}'; then
      printf '%s: the header names no source store (source: <store> [; <checksum>])\n' "${m#"$ROOT"/}"; bad=1
    fi
    if ! printf '%s\n' "$hdr" | grep -qoiE '[0-9a-f]{32}([^0-9a-f]|$)'; then
      printf '%s: the header carries no checksum (md5 or sha256 hex)\n' "${m#"$ROOT"/}"; bad=1
    fi
    if [ -z "$apkh" ]; then
      printf '%s: the manifest holds no *.apk row\n' "${m#"$ROOT"/}"; bad=1
    elif [ -n "$apk" ] && [ "${apkh#*$'\t'}" != "" ]; then
      local rowbase; rowbase=${apkh#*$'\t'}; rowbase=${rowbase##*/}
      if [ "$apk" != "$rowbase" ]; then
        printf '%s: the header names %s but the manifest rows %s\n' "${m#"$ROOT"/}" "$apk" "$rowbase"; bad=1
      fi
    fi
    if [ -n "$c64" ] && [ -n "$apkh" ]; then
      local rowhash; rowhash=${apkh%%$'\t'*}
      [ "$c64" = "$rowhash" ] || { printf '%s: the header sha256 %s disagrees with the apk row %s\n' "${m#"$ROOT"/}" "$c64" "$rowhash"; bad=1; }
    fi
  done
  [ "$bad" -eq 0 ] || return 1
  printf '%s acquisition record(s): target + version, source store, checksum, apk row\n' "$n"
  return 0
}

# rc_hdr_field <header text> <key> — the value of a `# key : value` header line, case-insensitive.
rc_hdr_field() {
  printf '%s\n' "$1" | awk -v k="$2" '
    /^#[[:space:]]*[A-Za-z_]+[[:space:]]*:/ {
      line = $0; sub(/^#[[:space:]]*/, "", line)
      key = line; sub(/:.*/, "", key); gsub(/[[:space:]]/, "", key)
      if (tolower(key) == tolower(k)) { v = line; sub(/^[^:]*:[[:space:]]*/, "", v); print v; exit }
    }
  '
}

# ---- the day-one framing (review 1, scope 3) ----------------------------------
# One shape is an undeserved red for a person who just cloned a repo: the repo looks freshly
# cloned (.gob committed, but fewer than 3 commits) -> one banner line after the verdict.
# Commit count only: an mtime comparison against the reflog fired after every ordinary GT-02
# write, so the banner lingered on aged repos (the verify itself refreshes last-gate-line
# forever); a repo under 3 commits is the only unambiguous fresh-clone shape.
fresh_clone() {
  [ -f "$INSTALLED" ] || return 1
  [ -d "$ROOT/.git" ] || return 1
  local n
  n=$(cd "$ROOT" && git rev-list --count HEAD 2>/dev/null) || return 1
  [ "$n" -lt 3 ] && return 0
  return 1
}

# ================================================================ runner ======

# ---- the repo-local override (batch 3) ---------------------------------------
# Read .gob/manifest/enforcement.local.tsv, validate it (THE HONESTY GATE), and merge its rows
# into the run. Placed here, after every builtin is defined, so a `goblin-verify --only <ID>`
# marker cell can be checked against the builtins that actually exist.
is_local_id() { case " $LOCAL_IDS " in *" $1 "*) return 0 ;; esac; return 1; }

# LOCAL_NO_VERDICT — set at run time when a LOCAL row's check COULD NOT EXECUTE (exit 126/127/137:
# not found / not executable / killed by a signal). Such a check "exited without producing a
# verdict": it is REFUSED at the end of the run, never read as a pass.
LOCAL_NO_VERDICT=""
setup_local_override() {
  [ -n "$LOCAL_FILE" ] || return 0
  local tmp _n=0 _id _scope _rule _eby _art _check _why _nf _hit _fn _line
  tmp=$(mktemp) || { g_err "mktemp failed"; exit 2; }
  cp "$MANIFEST" "$tmp"
  while IFS= read -r _line || [ -n "$_line" ]; do
    _line=${_line%$'\r'}
    case "$_line" in ''|'#'*) continue ;; esac
    _nf=$(printf '%s' "$_line" | awk -F'\t' '{print NF}')
    _id=${_line%%$'\t'*}
    if [ "$_nf" -lt 7 ]; then
      g_err "local override: '$_id' names a row id with no check."
      g_err "  a local row must carry the full 7-cell line; get it with: gob verify --library"
      g_err "  (an LX-* rule must supply its own check cell - a rule nothing verifies is refused)."
      exit 3
    fi
    IFS=$'\t' read -r _id _scope _rule _eby _art _check _why <<< "$_line"
    # the id must name a check the engine can run: a matrix row, a library row, or an LX-* rule.
    _hit=0
    awk -F'\t' -v x="$_id" 'NR>1 && $1==x {f=1} END{exit !f}' "$MANIFEST" && _hit=1
    if [ "$_hit" -eq 0 ] && [ -n "$LIBRARY_FILE" ]; then
      awk -F'\t' -v x="$_id" 'NR>1 && $1==x {f=1} END{exit !f}' "$LIBRARY_FILE" && _hit=1
    fi
    case "$_id" in LX-*) _hit=1 ;; esac
    if [ "$_hit" -eq 0 ]; then
      g_err "local override: '$_id' names no row the engine ships - it is in neither"
      g_err "  .gob/manifest/enforcement.tsv nor .gob/manifest/library.tsv."
      g_err "  a local row may only turn on a shipped row (see: gob verify --library) or declare"
      g_err "  an LX-* rule with its own check cell."
      exit 3
    fi
    # a builtin-marker check must have a builtin, or it can never produce a verdict.
    case "$_check" in
      "goblin-verify --only "*)
        _fn="check_$(printf '%s' "$_id" | tr 'A-Z' 'a-z' | tr '-' '_')"
        if ! declare -F "$_fn" >/dev/null 2>&1; then
          g_err "local override: '$_id' names a check the engine has no builtin for ($_fn)."
          g_err "  a local row cannot certify a rule nothing verifies."
          exit 3
        fi ;;
      "")
        case "$_eby" in
          advisory) ;;
          *) g_err "local override: '$_id' carries no check and is not advisory - nothing verifies it."
             exit 3 ;;
        esac ;;
    esac
    # a row the matrix already runs by default is a no-op here (never a duplicate).
    if awk -F'\t' -v x="$_id" 'NR>1 && $1==x {f=1} END{exit !f}' "$MANIFEST"; then
      g_info "local override: '$_id' is already on by default - ignored."
      continue
    fi
    printf '%s\n' "$_line" >> "$tmp"
    LOCAL_IDS="$LOCAL_IDS $_id"
    _n=$((_n + 1))
  done < "$LOCAL_FILE"
  if [ "$_n" -gt 0 ]; then
    RUN_MANIFEST="$tmp"
    _GOB_MANIFEST="$tmp"
    export _GOB_MANIFEST
  else
    rm -f "$tmp"
  fi
}
setup_local_override

PASS=0; FAIL=0; ADV=0; SKIP=0; BAD=0
JSON_ROWS=""

# json_escape <text> — a JSON string body. The detail of a check is arbitrary shell output
# (quotes, backslashes, newlines), so it must be escaped or --json emits invalid JSON (D3).
json_escape() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

emit() { # id status detail
  if [ "$JSON" -eq 1 ]; then
    JSON_ROWS="$JSON_ROWS{\"id\":\"$(json_escape "$1")\",\"status\":\"$(json_escape "$2")\",\"detail\":\"$(json_escape "$3")\"},"
  else
    case "$2" in
      PASS) g_pass "$1" "$3" ;;
      FAIL) g_fail "$1" "$3" ;;
      ADV)  g_adv  "$1" "$3" ;;
      SKIP) g_skip "$1" "$3" ;;
    esac
  fi
}

while IFS=$'\t' read -r id scope rule enforced_by artifact check why; do
  [ "$id" = "id" ] && continue
  [ -n "$id" ] || continue
  [ "$scope" = "target" ] || continue
  only_selected "$id" || continue

  part=$(row_part "$id")
  if [ -n "$part" ] && g_agents_part_disabled "$CONFIG" "$part"; then
    SKIP=$((SKIP + 1)); emit "$id" SKIP "$rule (opt-out: $part)"; continue
  fi
  if [ "$ARCHIVE" = "true" ]; then
    case "$id" in
      HP-*|GT-*|SP-*) SKIP=$((SKIP + 1)); emit "$id" SKIP "$rule (archive: true)"; continue ;;
    esac
  fi

  case "$check" in
    advisory)
      ADV=$((ADV + 1))
      emit "$id" ADV "$rule (advisory)"
      continue
      ;;
    goblin-verify\ --only\ *)
      fn="check_$(printf '%s' "$id" | tr 'A-Z' 'a-z' | tr '-' '_')"
      if ! command -v "$fn" >/dev/null 2>&1 && ! declare -F "$fn" >/dev/null 2>&1; then
        BAD=1; emit "$id" FAIL "$rule (no builtin implementation: $fn)"; continue
      fi
      detail=$("$fn" 2>&1); rc=$?
      ;;
    *)
      detail=$( cd "$ROOT" && bash -c "$check" 2>&1 ); rc=$?
      # A LOCAL row whose check could not execute (126 not executable / 127 not found /
      # 137 killed by a signal) exited WITHOUT producing a verdict: record it for the refusal
      # at the end of the run, rather than folding it into a FAIL a reader could mistake for a
      # verdict. A matrix row keeps the old fold (its checks are shipped and known).
      if is_local_id "$id"; then
        case "$rc" in
          126|127|137) LOCAL_NO_VERDICT="$LOCAL_NO_VERDICT $id(exit $rc)" ;;
        esac
      fi
      # A shell check has no advisory state: anything non-zero is a FAIL. Only builtins
      # (the 'goblin-verify --only <ID>' marker rows) may return 2 = advisory or 3 = skip.
      if [ "$rc" -eq 0 ]; then
        [ -n "$detail" ] || detail="($check)"
      else
        # GT-03's one-liner is self-explaining now (review 1, scope 5): the raw `test -f
        # ... -nt ...` invocation dump told the reader the mechanics and nothing about what
        # to do; the human line says both. The TSV remedy column carries the same sentence.
        if [ "$id" = "GT-03" ]; then
          detail="GT-03 the gate line is older than the last commit — re-run gob verify to refresh it (it rewrites .gob/last-gate-line)"
        else
          detail="($check -> exit $rc)"
        fi
        rc=1
      fi
      ;;
  esac

  case "$rc" in
    0) PASS=$((PASS + 1)); emit "$id" PASS "$detail" ;;
    1) FAIL=$((FAIL + 1)); emit "$id" FAIL "$detail" ;;
    2) ADV=$((ADV + 1));  emit "$id" ADV "$detail" ;;
    3) SKIP=$((SKIP + 1)); emit "$id" SKIP "$detail" ;;
    *) FAIL=$((FAIL + 1)); emit "$id" FAIL "$detail (exit $rc)" ;;
  esac
done < "$RUN_MANIFEST"

# ---- the honesty gate, run-time half: a local check that produced no verdict ----------------
# A local row's check that could not execute (exit 126/127/137) never produced a verdict, so it
# is REFUSED - exit 3, with the ids named - rather than reported as the FAIL the fold above made
# of it. Nothing about such a row is green.
if [ -n "$LOCAL_NO_VERDICT" ]; then
  g_err "local override: a check could not execute, so it produced NO verdict:$LOCAL_NO_VERDICT"
  g_err "  a local row's check must be runnable - a command that is not found (127), not"
  g_err "  executable (126), or killed by a signal (137) cannot verify the rule it names."
  g_err "  fix the check cell, or remove the row from .gob/manifest/enforcement.local.tsv."
  exit 3
fi

if [ "$JSON" -eq 1 ]; then
  _lib_n=0
  [ -n "$LIBRARY_FILE" ] && _lib_n=$(awk -F'\t' 'NR>1 && $1!="" {n++} END{print n+0}' "$LIBRARY_FILE")
  printf '{"root":"%s","passed":%d,"failed":%d,"advisory":%d,"skipped":%d,"library":%d,"rows":[%s]}\n' \
    "$(json_escape "$ROOT")" "$PASS" "$FAIL" "$ADV" "$SKIP" "$_lib_n" "${JSON_ROWS%,}"
else
  printf '      %d passed, %d failed, %d advisory, %d skipped\n' "$PASS" "$FAIL" "$ADV" "$SKIP"
  # Day-one framing: a fresh clone is not your debt. One banner line, after the
  # verdict; counts and exit codes untouched.
  if [ "$FAIL" -gt 0 ] && fresh_clone; then
    printf '      fresh clone detected: some of these fails are not yours — see docs/GUIDE.md §9 (day one for a new teammate)\n'
  fi
  # Z1-7: the advisory number above counts the rows the matrix LABELS advisory; a row that is
  # not advisory-labelled can also report ADV by design when its lane cannot be resolved here.
  # SK-03 counts the labelled rows, the ADV lines on screen are both, so a reader comparing
  # `advisory N of ceiling C` with more ADV lines sees the arithmetic. Print it.
  adv_labelled=$(awk -F'\t' 'NR>1 && ($4=="advisory" || $6=="advisory") {n++} END{print n+0}' "${RUN_MANIFEST:-$MANIFEST}")
  if [ "$ADV" -ne "$adv_labelled" ]; then
    printf '      of those %d advisory: the matrix labels %d row(s) advisory; the difference is the non-advisory row(s) reporting ADV by design (an unresolved lane) and any labelled row skipped by an opt-out\n' \
      "$ADV" "$adv_labelled"
  else
    printf '      of those %d advisory: the matrix labels %d row(s) advisory\n' \
      "$ADV" "$adv_labelled"
  fi
  # The library census (batch 2b-ii). A green default run must never read as the whole story:
  # the rows this run did NOT check are counted here, with the surface that lists them. The
  # count is read from library.tsv, so it tracks the shipped row set rather than a typed number.
  if [ -n "$LIBRARY_FILE" ]; then
    _lib_n=$(awk -F'\t' 'NR>1 && $1!="" {n++} END{print n+0}' "$LIBRARY_FILE")
    printf '      library: %d off-by-default row(s) held but NOT run - discover them with `gob verify --library`\n' \
      "$_lib_n"
  fi
  # The local-override census (batch 3): a row turned ON through .gob/manifest/enforcement.local.tsv
  # is named here, so a reader can tell the locally-enabled rows apart from the default set.
  if [ -n "$LOCAL_IDS" ]; then
    printf '      enabled-locally: %d row(s) added by .gob/manifest/enforcement.local.tsv:%s\n' \
      "$(printf '%s' "$LOCAL_IDS" | wc -w | tr -d ' ')" "$LOCAL_IDS"
  fi
  # The collapsed listing keeps one line per row (a SKIP's reason is the row's whole
  # point and scripts read them by id); the width discipline lives in the lib's printers.
  if [ "$VERBOSE" -eq 1 ]; then
    cat <<'SEE'
      cannot see: whether a check in the harness dir tests the right path rather than
      merely passing; whether the forge is bound by the workflow the repo declares found; whether a human
      read the diff; and whether .gob/installed.json — the record every drift
      check trusts — was itself rewritten. It is not signed, so one edit to it (with the
      matching edit to the file it protects) defeats IN-02, SK-02 and HS-01 at once
      (docs/LIMITS.md #18). The ban lane carries the same blind spot and two of its own:
      the ban table is a manifest file under the same unsigned record, so a defanged ban
      passes BN-00 (docs/LIMITS.md #28); a ban probe is a TEXT probe with no AST, so a
      `Record<string, any>` is missed and a `: any` inside a string is reported
      (docs/LIMITS.md #27); and no check here can reach a ban IN CONTEXT — the row proves
      the forbidden path fails mechanically, never that the ban reached the agent that
      wrote the line. The reference-corpus lane adds its own: RC-01 matches EXACT sha256 only,
      so a resized, recoloured or re-encoded reference asset, or copied text inside a shipped
      string, passes it unseen; RC-02 proves the manifest is well-shaped, never that its entries
      are the right hashes (as strong as tamper hashing, and installed.json is unsigned); RC-03
      reads the tracked tree and cannot see a payload renamed and re-encoded; and RC-04 proves an
      acquisition record EXISTS, never that the number beside it came from the store (HP-03's
      defect, one artifact over). No row here reaches a reference asset in CONTEXT either.
SEE
  else
    # The same statement, folded to a pointer. The unsigned-record admission rides the
    # short form too: a doc pin (F2-3) reads it out of every run, not only verbose ones.
    cat <<'SEE'
      cannot see: whether a check tests the right path rather than merely passing; whether a
      human read the diff; whether the unsigned install record (.gob/installed.json — it is
      not signed) was rewritten; and the per-lane blind spots of the ban and
      reference lanes. Full statement: `goblin-verify --verbose`, docs/LIMITS.md #18 #27 #28 #43.
SEE
  fi
  # ---- the sign-off (locked v2 decision) ----------------------------------------
  # The mascot is a GREEN-run line only. A red run ends on the concrete first command:
  # the verdict IS the FAIL list, and the first row's remedy line says the fix — mascot
  # noise on the run's one actionable moment is exactly what the red tail must not be.
  # Human branch only: a --json run stays machine-clean.
  if [ "$FAIL" -gt 0 ] || [ "$BAD" -eq 1 ]; then
    printf '      start with the first FAIL above — its remedy line says the fix.\n'
  else
    printf '      ▙ the goblin sees you. keep the gate green.\n'
  fi
  # ---- the engine footer (W1 §2.2, R-1's residue -> docs/LIMITS.md #43) --------
  # Every run states WHICH engine judged it: the sha256 of the running verifier and of
  # the manifest that judged this run, so a repo can name its judge. The statement is
  # UNSIGNED and forgeable - one forgery now covers N repos - which is the hole LIMITS
  # #43 records, deliberately not fixed in W1 (G6).
  # W6: the banner goes to STDERR, not stdout (LIM-51). A consumer capturing verify's
  # output parses check lines; a footer line interleaved with them is parser friction
  # (docs/LIMITS.md #49 recorded the cost before the fix). The banner is a STATEMENT,
  # not a verdict line - diagnostics belong on the error stream. Captured stdout after
  # the move carries PASS/FAIL/ADV/SKIP lines and the summary only; the banner stays
  # visible in a terminal and in any `2>&1` merge (every suite that asserts the
  # footer merges the streams).
  printf '      engine: mode=%s' "$ENGINE_MODE" >&2
  if [ -n "$GOBLIN_ENGINE" ]; then printf ' engine_dir=%s' "$GOBLIN_ENGINE" >&2; fi
  printf ' cli_sha256=%s enforcement_tsv_sha256=%s\n' \
    "$(g_sha256_file "$SELF_DIR/goblin-verify")" \
    "$(g_sha256_file "$MANIFEST")" >&2
  # ---- the shadow advisory (W3 §3.2) -------------------------------------------
  # A vendored payload under .gob/ while the record says mode=global: the chain's
  # vendored step (2) beats the declared engine_dir (3) — W1's ordering, kept
  # deliberately — so a STALE vendored table judged this run while the footer above
  # still prints mode=global. This line names that split. It is deliberately a footer
  # ADVISORY, not a manifest row: the advisory ceiling is `advisory 10 of ceiling 10`
  # on every migrated repo (SK-03 measured at W3-SPEC MA5, 0 free slots), so a new row
  # would fail every migrated repo — and adding a row is a G2 rule change W3 has no
  # mandate for. Detector, not prevention: the residue is LIMITS #45.
  if [ "$ENGINE_MODE" = "global" ]; then
    _shadow_n=0
    for _f in "$ROOT"/.gob/bin/goblin-verify "$ROOT"/.gob/bin/goblin-lib.sh \
              "$ROOT"/.gob/bin/goblin-bans \
              "$ROOT"/.gob/manifest/* "$ROOT"/.gob/bans/*; do
      [ -e "$_f" ] || continue
      _shadow_n=$((_shadow_n + 1))
    done
    if [ "$_shadow_n" -gt 0 ]; then
      printf '      shadow: vendored engine payload present (%d file(s)) - the vendored table judged this run, not the declared engine_dir\n' "$_shadow_n"
    fi
    unset _shadow_n _f
  fi
fi

if [ "$FAIL" -gt 0 ] || [ "$BAD" -eq 1 ]; then exit 1; fi
exit 0
